---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { 
  AlertTriangle, 
  Search, 
  Filter, 
  CheckCircle2, 
  Clock, 
  ShieldAlert, 
  Ban, 
  MessageSquare, 
  ChevronRight,
  UserX,
  FileWarning
} from 'lucide-react';
---

<AdminLayout title="Tickets & Harassment Center — DMB Admin" activePath="/admin/tickets/">
  
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-1">
        <a href="/admin/" class="hover:text-navy-900 transition-colors">Admin</a>
        <ChevronRight className="w-3 h-3" />
        <span class="text-navy-900 font-bold">Harassment & Dispute Center</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-black text-navy-900 tracking-tight">Reports & Support Tickets</h1>
      <p class="text-xs sm:text-sm text-slate-500 font-medium mt-0.5">
        Audit member reports, harassment allegations, fake PMDC claims, and user disputes with immediate enforcement.
      </p>
    </div>

    <div class="flex items-center gap-2">
      <span class="px-3 py-1.5 rounded-xl text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200">
        Zero Tolerance Harassment Policy Active
      </span>
    </div>
  </div>

  <!-- Tickets List -->
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 border-b border-slate-200/80 text-slate-600 font-bold uppercase tracking-wider text-[11px]">
          <tr>
            <th class="py-3.5 px-4">Ticket ID & Priority</th>
            <th class="py-3.5 px-4">Reporter</th>
            <th class="py-3.5 px-4">Subject & Details</th>
            <th class="py-3.5 px-4">Date</th>
            <th class="py-3.5 px-4">Status</th>
            <th class="py-3.5 px-4 text-right">Enforcement Actions</th>
          </tr>
        </thead>
        <tbody id="tickets-tbody" class="divide-y divide-slate-100 font-medium">
          <!-- Populated by JavaScript -->
          <tr>
            <td colspan="6" class="py-12 text-center text-slate-400">Loading incident tickets...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

</AdminLayout>

<script>
  import { AdminStore, type AdminTicket } from '../../lib/api/admin';
  import { showToast } from '../../lib/toast';

  let ticketsCache: AdminTicket[] = [];

  async function renderTickets() {
    const tbody = document.getElementById('tickets-tbody');
    if (!tbody) return;
    tbody.innerHTML = '<tr><td colspan="6" class="py-12 text-center text-slate-400">Loading live tickets from API...</td></tr>';
    try {
      const list = await AdminStore.getTickets();
      ticketsCache = list;

      if (list.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="py-12 text-center text-slate-500">No live data — no open reports or tickets.</td></tr>';
        return;
      }

      tbody.innerHTML = list.map(t => `
      <tr class="hover:bg-slate-50/80 transition-colors">
        <td class="py-4 px-4">
          <span class="font-mono font-bold text-navy-900 block">${t.ticket_number}</span>
          <span class="inline-block mt-1 px-2 py-0.5 rounded-full text-[10px] font-black uppercase ${
            t.priority === 'urgent' || t.priority === 'high' 
              ? 'bg-rose-100 text-rose-700 border border-rose-200' 
              : 'bg-amber-100 text-amber-700'
          }">
            ${t.priority}
          </span>
        </td>
        <td class="py-4 px-4">
          <p class="font-bold text-navy-900">${t.reporter_name}</p>
          <p class="text-[11px] text-slate-400">${t.reporter_email}</p>
        </td>
        <td class="py-4 px-4 max-w-sm">
          <p class="font-bold text-slate-800 text-xs">${t.subject}</p>
          <p class="text-[11px] text-slate-500 mt-0.5 line-clamp-2">${t.description}</p>
        </td>
        <td class="py-4 px-4 text-slate-500 text-[11px]">
          ${t.created_at}
        </td>
        <td class="py-4 px-4">
          <span class="px-2.5 py-1 rounded-full text-[10px] font-bold ${
            t.status === 'resolved' 
              ? 'bg-emerald-100 text-emerald-700' 
              : t.status === 'in_progress'
              ? 'bg-blue-100 text-blue-700'
              : 'bg-amber-100 text-amber-700 animate-pulse'
          }">
            ${t.status.toUpperCase()}
          </span>
        </td>
        <td class="py-4 px-4 text-right">
          ${t.status !== 'resolved' ? `
            <div class="flex items-center justify-end gap-1.5">
              <button 
                data-action="resolve-ticket" 
                data-id="${t.id}"
                class="px-2.5 py-1.5 rounded-lg text-[11px] font-bold bg-emerald-600 hover:bg-emerald-700 text-white transition-colors"
              >
                Resolve
              </button>
              <button 
                data-action="dismiss-ticket" 
                data-id="${t.id}"
                class="px-2 py-1.5 rounded-lg text-[11px] font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors"
              >
                Dismiss
              </button>
            </div>
          ` : `
            <span class="text-xs text-slate-400">Case Closed</span>
          `}
        </td>
      </tr>
    `).join('');

      // Bind actions (re-bound after render)
      document.querySelectorAll('[data-action="resolve-ticket"]').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          const id = Number((e.currentTarget as HTMLElement).getAttribute('data-id'));
          try {
            await AdminStore.resolveTicket(id, 'resolved', 'Investigated and resolved by Admin');
            showToast({
              title: 'Report Resolved',
              message: 'Incident marked as resolved in system logs.',
              type: 'info'
            });
            await renderTickets();
          } catch (err: any) {
            showToast({ title: 'Resolve failed', message: err?.response?.data?.message || err?.message || 'Failed to resolve ticket.', type: 'error' });
          }
        });
      });

      document.querySelectorAll('[data-action="dismiss-ticket"]').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          const id = Number((e.currentTarget as HTMLElement).getAttribute('data-id'));
          try {
            await AdminStore.resolveTicket(id, 'dismissed', 'Dismissed after review');
            showToast({
              title: 'Report Dismissed',
              message: 'Ticket dismissed.',
              type: 'info'
            });
            await renderTickets();
          } catch (err: any) {
            showToast({ title: 'Dismiss failed', message: err?.response?.data?.message || err?.message || 'Failed to dismiss ticket.', type: 'error' });
          }
        });
      });
    } catch (err: any) {
      tbody.innerHTML = `<tr><td colspan="6" class="py-12 text-center text-rose-600">${err?.response?.data?.message || err?.message || 'Failed to load live tickets. Please retry.'}</td></tr>`;
    }
  }

  async function initTickets() {
    await renderTickets();
  }

  document.addEventListener('DOMContentLoaded', initTickets);
  document.addEventListener('astro:page-load', initTickets);
</script>
