---
import DashboardLayout from '../layouts/DashboardLayout.astro';
---

<DashboardLayout
  title="Doctor Notifications & Activity — Doctor Marriage Bureau"
  description="Stay updated with doctor marriage proposals, messages, and profile views."
>
  <div class="space-y-8 animate-fadeIn max-w-4xl">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl sm:text-3xl font-black text-navy-800 font-serif">
          Notification <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-500 via-brand-600 to-pink-600">Center</span>
        </h1>
        <p id="notif-sub" class="text-xs sm:text-sm text-navy-500">Real-time updates from your matchmaking activity</p>
      </div>
      <button id="mark-all" type="button" class="text-xs font-bold text-brand-600 hover:text-brand-700">Mark All as Read</button>
    </div>
    <div id="notif-list" class="space-y-3"></div>
  </div>

  <div id="notif-modal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-navy-900/50 px-3 py-4 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="notif-modal-title">
    <div class="flex min-h-full items-start justify-center md:items-center">
      <div class="w-full max-w-2xl overflow-hidden rounded-[28px] bg-white shadow-luxury">
        <div class="flex items-start justify-between gap-4 border-b border-navy-100 px-6 py-5 md:px-8">
          <div class="min-w-0">
            <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-brand-600">Notification</p>
            <h2 id="notif-modal-title" class="mt-2 text-xl font-bold text-navy-800 font-serif"></h2>
          </div>
          <button id="notif-modal-close" type="button" class="flex size-10 shrink-0 items-center justify-center rounded-full bg-navy-50 text-navy-500 hover:bg-navy-100" aria-label="Close">✕</button>
        </div>
        <div class="px-6 py-6 md:px-8 space-y-5">
          <div class="flex flex-wrap gap-3">
            <div class="rounded-2xl bg-navy-50 px-4 py-3 min-w-[140px]">
              <p class="text-[10px] font-semibold uppercase tracking-wide text-navy-400">Date</p>
              <p id="notif-modal-date" class="text-sm font-semibold text-navy-800"></p>
            </div>
            <div class="rounded-2xl bg-navy-50 px-4 py-3 min-w-[140px]">
              <p class="text-[10px] font-semibold uppercase tracking-wide text-navy-400">Time</p>
              <p id="notif-modal-time" class="text-sm font-semibold text-navy-800"></p>
            </div>
            <div class="rounded-2xl bg-brand-50 px-4 py-3 min-w-[140px]">
              <p class="text-[10px] font-semibold uppercase tracking-wide text-brand-500">Status</p>
              <p id="notif-modal-status" class="text-sm font-semibold text-navy-800"></p>
            </div>
          </div>
          <div class="rounded-3xl border border-navy-100 bg-navy-50/60 px-5 py-5">
            <p class="mb-2 text-xs font-semibold text-navy-500">Full details</p>
            <p id="notif-modal-body" class="whitespace-pre-line text-sm leading-7 text-navy-700"></p>
          </div>
        </div>
        <div class="flex flex-col-reverse gap-3 border-t border-navy-100 px-6 py-5 md:flex-row md:justify-end md:px-8">
          <button id="notif-modal-dismiss" type="button" class="rounded-full border border-navy-200 px-5 py-3 text-sm font-semibold text-navy-700 hover:bg-navy-50">Close</button>
          <a id="notif-modal-open" href="/dashboard/" class="hidden rounded-full bg-gradient-to-r from-brand-500 via-brand-600 to-pink-600 px-5 py-3 text-center text-sm font-semibold text-white">Open related page</a>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  import { api, escapeHtml, formatDate, formatTime, toast, errorMessage, emptyStateHtml, errorStateHtml, skeletonHtml } from '../lib/dashboard/common';

  type Notif = {
    id: string;
    type: string;
    title: string;
    body: string;
    action_url?: string;
    data?: Record<string, unknown>;
    read_at?: string | null;
    created_at?: string;
  };

  const list = document.getElementById('notif-list')!;
  const modal = document.getElementById('notif-modal')!;
  const modalTitle = document.getElementById('notif-modal-title')!;
  const modalDate = document.getElementById('notif-modal-date')!;
  const modalTime = document.getElementById('notif-modal-time')!;
  const modalStatus = document.getElementById('notif-modal-status')!;
  const modalBody = document.getElementById('notif-modal-body')!;
  const modalOpen = document.getElementById('notif-modal-open') as HTMLAnchorElement;
  let items: Notif[] = [];

  function isPhpClass(value: string): boolean {
    return /\\|DbStoreNotification|App\/Notifications/.test(value);
  }

  function routeToPath(route: string): string {
    const value = route.trim();
    if (!value) return '';
    const lower = value.toLowerCase();
    if (lower.startsWith('http://') || lower.startsWith('https://') || value.startsWith('/')) return value;
    if (lower.includes('interest') || lower.includes('proposal')) return '/proposals/';
    if (lower.includes('chat') || lower.includes('message')) return '/messages/';
    if (lower.includes('wallet')) return '/wallet/';
    if (lower.includes('profile')) return '/profile/';
    if (lower.includes('package')) return '/packages/';
    return '';
  }

  function present(n: Notif): Notif {
    const data = n.data || {};
    const message = String(data.message ?? n.body ?? '').trim();
    let title = String(data.title ?? n.title ?? '').trim();
    if (!title || isPhpClass(title)) title = message || 'Notification';
    let type = String(data.type ?? n.type ?? 'system');
    if (isPhpClass(type)) type = String(data.type || 'system');
    const action = String(n.action_url || data.action_url || routeToPath(String(data.route || '')) || '').trim();
    return { ...n, title, body: message || String(n.body || ''), type, action_url: action };
  }

  function iconFor(type: string) {
    if (type.includes('interest') || type.includes('proposal')) return { bg: 'bg-brand-50 text-brand-600', glyph: '💌' };
    if (type.includes('chat') || type.includes('message')) return { bg: 'bg-navy-100 text-navy-600', glyph: '💬' };
    if (type.includes('verif')) return { bg: 'bg-emerald-50 text-emerald-600', glyph: '✓' };
    return { bg: 'bg-navy-100 text-navy-600', glyph: '🔔' };
  }

  function closeModal() {
    modal.classList.add('hidden');
    document.body.style.overflow = '';
  }

  function openModal(n: Notif) {
    const item = present(n);
    modalTitle.textContent = item.title;
    modalDate.textContent = formatDate(item.created_at);
    modalTime.textContent = formatTime(item.created_at) || '—';
    modalStatus.textContent = item.read_at ? 'Read' : 'Unread';
    modalBody.textContent = item.body || 'No details available';
    if (item.action_url) {
      modalOpen.href = item.action_url;
      modalOpen.classList.remove('hidden');
    } else {
      modalOpen.classList.add('hidden');
    }
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    if (!item.read_at) {
      api.post(`/notifications/${item.id}/read`).catch(() => undefined);
      item.read_at = new Date().toISOString();
      n.read_at = item.read_at;
      const row = list.querySelector<HTMLElement>(`[data-id="${item.id}"]`);
      if (row) {
        row.classList.remove('border-brand-200', 'ring-1', 'ring-brand-500/10');
        row.classList.add('opacity-90');
      }
    }
  }

  async function load() {
    list.innerHTML = skeletonHtml(4, 'h-20');
    try {
      const res = await api.get('/notifications/');
      const data = res.data?.data ?? {};
      items = ((data.items ?? data ?? []) as Notif[]).map(present);
      const unread = Number(data.unread_count ?? items.filter((n) => !n.read_at).length);
      document.getElementById('notif-sub')!.textContent = unread ? `${unread} unread update${unread === 1 ? '' : 's'}` : 'You are all caught up';
      if (!items.length) {
        list.innerHTML = emptyStateHtml('No notifications yet', 'Proposal, chat, and verification alerts will appear here.', '🔔');
        return;
      }
      list.innerHTML = items
        .map((n) => {
          const unreadCls = n.read_at ? 'bg-white/80 border-navy-100 opacity-90' : 'bg-white border-brand-200 ring-1 ring-brand-500/10';
          const ic = iconFor(String(n.type || ''));
          const preview = n.body && n.body !== n.title ? n.body : '';
          return `
            <button type="button" data-id="${escapeHtml(n.id)}" class="w-full text-left p-5 rounded-3xl border ${unreadCls} flex items-start gap-4 transition-all hover:border-brand-300">
              <div class="p-3 rounded-2xl ${ic.bg} shrink-0 text-lg">${ic.glyph}</div>
              <div class="flex-1 min-w-0 space-y-2">
                <div class="flex items-start justify-between gap-3">
                  <h3 class="text-sm font-bold text-navy-800">${escapeHtml(n.title)}</h3>
                  <div class="shrink-0 text-right leading-tight">
                    <p class="text-[10px] font-semibold uppercase tracking-wide text-navy-400">Date</p>
                    <p class="text-[11px] font-semibold text-navy-700">${escapeHtml(formatDate(n.created_at))}</p>
                    <p class="mt-1 text-[10px] font-semibold uppercase tracking-wide text-navy-400">Time</p>
                    <p class="text-[11px] font-semibold text-navy-700">${escapeHtml(formatTime(n.created_at) || '—')}</p>
                  </div>
                </div>
                ${preview ? `<p class="text-xs text-navy-600 leading-relaxed line-clamp-2">${escapeHtml(preview)}</p>` : ''}
              </div>
            </button>`;
        })
        .join('');
      list.querySelectorAll<HTMLButtonElement>('[data-id]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const found = items.find((item) => item.id === btn.dataset.id);
          if (found) openModal(found);
        });
      });
    } catch (err) {
      list.innerHTML = errorStateHtml(errorMessage(err));
      list.querySelector('[data-dmb-retry]')?.addEventListener('click', load);
    }
  }

  modal.addEventListener('click', (event) => {
    if (event.target === modal) closeModal();
  });
  document.getElementById('notif-modal-close')!.addEventListener('click', closeModal);
  document.getElementById('notif-modal-dismiss')!.addEventListener('click', closeModal);
  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
  });

  document.getElementById('mark-all')!.addEventListener('click', async () => {
    try {
      await api.post('/notifications/read-all');
      toast('All notifications marked as read.', 'success');
      load();
    } catch (err) {
      toast(errorMessage(err), 'error');
    }
  });
  load();
</script>