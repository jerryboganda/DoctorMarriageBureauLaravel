---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { 
  HeartHandshake, 
  Search, 
  Sparkles, 
  CheckCircle2, 
  Clock, 
  XCircle, 
  PhoneCall, 
  ChevronRight,
  ArrowRight
} from 'lucide-react';
---

<AdminLayout title="Matchmaking & Proposals Oversight — DMB Admin" activePath="/admin/proposals/">
  
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-1">
        <a href="/admin/" class="hover:text-navy-900 transition-colors">Admin</a>
        <ChevronRight className="w-3 h-3" />
        <span class="text-navy-900 font-bold">Matchmaking Governance</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-black text-navy-900 tracking-tight">Courtship Proposals & Matches</h1>
      <p class="text-xs sm:text-sm text-slate-500 font-medium mt-0.5">
        Monitor halal doctor matchmaking interactions, proposal statuses, and family contact exchanges.
      </p>
    </div>

    <!-- Match Stats -->
    <div class="flex items-center gap-2 text-xs">
      <div class="px-3 py-2 rounded-xl bg-white border border-slate-200 shadow-sm">
        <span class="text-slate-500">Compatibility AI:</span>
        <span class="font-bold text-navy-900 ml-1">Active (95%+ Matches)</span>
      </div>
    </div>
  </div>

  <!-- Proposals Table -->
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 border-b border-slate-200/80 text-slate-600 font-bold uppercase tracking-wider text-[11px]">
          <tr>
            <th class="py-3.5 px-4">Initiating Doctor (Sender)</th>
            <th class="py-3.5 px-4 text-center">Match Rating</th>
            <th class="py-3.5 px-4">Receiving Doctor (Recipient)</th>
            <th class="py-3.5 px-4">Status & Progression</th>
            <th class="py-3.5 px-4">Date Initiated</th>
            <th class="py-3.5 px-4 text-right">Notes</th>
          </tr>
        </thead>
        <tbody id="proposals-tbody" class="divide-y divide-slate-100 font-medium">
          <!-- Populated by JavaScript -->
          <tr>
            <td colspan="6" class="py-12 text-center text-slate-400">Loading courtship proposals...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

</AdminLayout>

<script>
  import { AdminStore } from '../../lib/api/admin';
  import { showToast } from '../../lib/toast';

  let proposalsCache: any[] = [];

  async function renderProposals() {
    const tbody = document.getElementById('proposals-tbody');
    if (!tbody) return;
    tbody.innerHTML = '<tr><td colspan="6" class="py-12 text-center text-slate-400">Loading live proposals from API...</td></tr>';
    try {
      const list = await AdminStore.getProposals();
      proposalsCache = list;
      if (list.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="py-12 text-center text-slate-500">No live data — no proposals recorded.</td></tr>';
        return;
      }
      tbody.innerHTML = list.map(p => {
        const senderInitials = (p.sender_name || 'Dr').trim().split(/\s+/).map((n: string) => n[0]).slice(0, 2).join('').toUpperCase() || 'DR';
        const recipientInitials = (p.recipient_name || 'Dr').trim().split(/\s+/).map((n: string) => n[0]).slice(0, 2).join('').toUpperCase() || 'DR';
        const hasSenderAvatar = p.sender_avatar && p.sender_avatar.trim() !== '' && p.sender_avatar !== 'null';
        const hasRecipientAvatar = p.recipient_avatar && p.recipient_avatar.trim() !== '' && p.recipient_avatar !== 'null';

        return `
        <tr class="hover:bg-slate-50/80 transition-colors">
          <td class="py-4 px-4">
            <div class="flex items-center gap-3">
              <div class="relative w-9 h-9 rounded-xl overflow-hidden ring-1 ring-slate-200 bg-gradient-to-tr from-brand-600 via-rose-500 to-pink-600 text-white flex items-center justify-center font-bold text-xs shrink-0">
                ${hasSenderAvatar ? `
                  <img 
                    src="${p.sender_avatar}" 
                    class="w-full h-full object-cover" 
                    alt="${p.sender_name}" 
                    onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
                  />
                  <span style="display:none;" class="w-full h-full flex items-center justify-center font-bold text-xs uppercase">${senderInitials}</span>
                ` : `
                  <span class="w-full h-full flex items-center justify-center font-bold text-xs uppercase">${senderInitials}</span>
                `}
              </div>
              <div>
                <a href="/admin/doctors/view/?id=${p.sender_id}" class="font-bold text-navy-900 hover:text-brand-600 transition-colors block">
                  ${p.sender_name || 'Doctor'}
                </a>
                <p class="text-[11px] text-slate-400">${p.sender_specialty || ''}</p>
              </div>
            </div>
          </td>
          <td class="py-4 px-4 text-center">
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-black bg-rose-50 text-rose-700 border border-rose-200">
              ✨ ${p.match_percentage || 85}%
            </span>
          </td>
          <td class="py-4 px-4">
            <div class="flex items-center gap-3">
              <div class="relative w-9 h-9 rounded-xl overflow-hidden ring-1 ring-slate-200 bg-gradient-to-tr from-brand-600 via-rose-500 to-pink-600 text-white flex items-center justify-center font-bold text-xs shrink-0">
                ${hasRecipientAvatar ? `
                  <img 
                    src="${p.recipient_avatar}" 
                    class="w-full h-full object-cover" 
                    alt="${p.recipient_name}" 
                    onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
                  />
                  <span style="display:none;" class="w-full h-full flex items-center justify-center font-bold text-xs uppercase">${recipientInitials}</span>
                ` : `
                  <span class="w-full h-full flex items-center justify-center font-bold text-xs uppercase">${recipientInitials}</span>
                `}
              </div>
              <div>
                <a href="/admin/doctors/view/?id=${p.recipient_id}" class="font-bold text-navy-900 hover:text-brand-600 transition-colors block">
                  ${p.recipient_name || 'Doctor'}
                </a>
                <p class="text-[11px] text-slate-400">${p.recipient_specialty || ''}</p>
              </div>
            </div>
          </td>
          <td class="py-4 px-4">
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold ${
              p.status === 'accepted' ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700'
            }">
              ${p.status === 'accepted' ? '✓ PROPOSAL ACCEPTED' : (p.status || 'PENDING').toUpperCase()}
            </span>
          </td>
          <td class="py-4 px-4 text-slate-500 text-[11px]">
            ${p.created_at}
          </td>
          <td class="py-4 px-4 text-right text-slate-600 text-[11px]">
            ${p.notes || 'Family review in progress'}
          </td>
        </tr>
        `;
      }).join('');
    } catch (err: any) {
      tbody.innerHTML = `<tr><td colspan="6" class="py-12 text-center text-rose-600">${err?.response?.data?.message || err?.message || 'Failed to load live proposals. Please retry.'}</td></tr>`;
      showToast({ title: 'Failed to load proposals', message: err?.response?.data?.message || err?.message || 'Failed to load live proposals.', type: 'error' });
    }
  }

  async function initProposals() {
    await renderProposals();
  }

  document.addEventListener('DOMContentLoaded', initProposals);
  document.addEventListener('astro:page-load', initProposals);
</script>
