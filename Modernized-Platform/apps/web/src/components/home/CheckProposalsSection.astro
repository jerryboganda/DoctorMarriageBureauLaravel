---
import ProposalsCarousel from '../islands/ProposalsCarousel';
import { ArrowRight, PhoneCall } from 'lucide-react';
---

<section id="proposals" class="py-20 lg:py-24 bg-gradient-to-b from-[#FAFAFD] to-white relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <div class="max-w-2xl">
        <span class="inline-block px-3.5 py-1.5 rounded-full text-xs font-semibold text-brand-600 bg-brand-50 border border-brand-100 tracking-wider uppercase mb-3">
          Active Candidates
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-navy-900 tracking-tight">
          Recent Doctor Proposals
        </h2>
        <p class="mt-3 text-sm sm:text-base text-navy-600 leading-relaxed">
          Explore recently verified doctor candidates from across Pakistan and abroad. Full profile details are accessible to registered members.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a 
          href="/contact/" 
          class="px-5 py-2.5 rounded-full text-xs font-semibold text-navy-800 bg-white hover:bg-navy-50 border border-navy-200 shadow-sm transition-colors flex items-center gap-2"
        >
          <PhoneCall className="w-3.5 h-3.5 text-brand-500" />
          <span>Contact Bureau</span>
        </a>
        <a 
          href="/register/" 
          class="px-5 py-2.5 rounded-full text-xs font-bold text-white bg-brand-500 hover:bg-brand-600 shadow-md shadow-brand-500/20 transition-all flex items-center gap-1.5"
        >
          <span>Register to View All</span>
          <ArrowRight className="w-3.5 h-3.5" />
        </a>
      </div>
    </div>

    <!-- Live Dynamic Proposals Island Component -->
    <ProposalsCarousel client:visible />

  </div>
</section>
