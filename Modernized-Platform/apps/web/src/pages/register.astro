---
import PublicLayout from '../layouts/PublicLayout.astro';
import { 
  ShieldCheck, 
  User, 
  Mail, 
  Phone, 
  Lock, 
  GraduationCap, 
  MapPin, 
  ArrowRight, 
  CheckCircle2, 
  Sparkles 
} from 'lucide-react';
---

<PublicLayout 
  title="Doctor Registration — Doctor Marriage Bureau"
  description="Register for verified, halal matchmaking exclusively for Muslim doctors and medical specialists."
>
  <div class="min-h-[85vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-slate-50 via-white to-pink-50/20">
    <div class="w-full max-w-xl space-y-8 animate-fadeIn">
      
      <!-- Card Container -->
      <div class="bg-white rounded-3xl p-8 sm:p-10 border border-brand-100/80 shadow-luxury space-y-6">
        
        <!-- Header -->
        <div class="text-center space-y-2">
          <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-brand-50 border border-brand-100 text-brand-600 text-xs font-bold">
            <Sparkles className="w-4 h-4" />
            <span>Doctors Matrimonial Registration</span>
          </div>

          <h1 class="text-2xl sm:text-3xl font-extrabold text-navy-900 font-serif">
            Create Your <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-500 to-pink-500">Doctor Profile</span>
          </h1>

          <p class="text-xs text-navy-500">
            Join thousands of verified doctors, MBBS, FCPS specialists, and dentists finding compatible life partners
          </p>
        </div>

        <!-- Multi-Step Indicator -->
        <div class="grid grid-cols-3 gap-2 text-center text-xs font-bold">
          <div class="p-2 rounded-xl bg-brand-500 text-white shadow-sm">1. Basic Info</div>
          <div class="p-2 rounded-xl bg-slate-100 text-navy-500">2. Medical Degrees</div>
          <div class="p-2 rounded-xl bg-slate-100 text-navy-500">3. Verification</div>
        </div>

        <!-- Error Banner -->
        <div id="reg-error" class="hidden rounded-2xl bg-brand-50 border border-brand-200 px-4 py-3 text-xs font-semibold text-brand-700"></div>

        <!-- Registration Form -->
        <form id="reg-form" class="space-y-4">
          
          <!-- Name Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="space-y-1.5">
              <label class="text-xs font-bold text-navy-700">First Name</label>
              <div class="relative">
                <input 
                  type="text" 
                  id="reg-first-name"
                  required 
                  placeholder="Ahmed"
                  class="w-full pl-10 pr-4 py-3 rounded-2xl text-xs bg-slate-50 border border-slate-200 focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 text-navy-900 outline-none transition-all"
                />
                <User className="w-4 h-4 text-navy-400 absolute left-3.5 top-1/2 -translate-y-1/2" />
              </div>
            </div>

            <div class="space-y-1.5">
              <label class="text-xs font-bold text-navy-700">Last Name</label>
              <input 
                type="text" 
                id="reg-last-name"
                required 
                placeholder="Khan"
                class="w-full px-4 py-3 rounded-2xl text-xs bg-slate-50 border border-slate-200 focus:bg-white focus:border-brand-500 outline-none text-navy-900"
              />
            </div>
          </div>

          <!-- Gender & Birthday Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="space-y-1.5">
              <label class="text-xs font-bold text-navy-700">Gender</label>
              <select id="reg-gender" required class="w-full py-3 px-3 rounded-2xl text-xs bg-slate-50 border border-slate-200 text-navy-900 outline-none focus:border-brand-500">
                <option value="">Select gender…</option>
                <option value="male">Male</option>
                <option value="female">Female</option>
              </select>
            </div>

            <div class="space-y-1.5">
              <label class="text-xs font-bold text-navy-700">Date of Birth</label>
              <input 
                type="date" 
                id="reg-birthday"
                required 
                class="w-full py-3 px-3 rounded-2xl text-xs bg-slate-50 border border-slate-200 text-navy-900 outline-none focus:border-brand-500"
              />
            </div>
          </div>

          <!-- Profile For -->
          <div class="space-y-1.5">
            <label class="text-xs font-bold text-navy-700">Creating Profile For</label>
            <select id="reg-on-behalf" class="w-full py-3 px-3 rounded-2xl text-xs bg-slate-50 border border-slate-200 text-navy-900 outline-none focus:border-brand-500">
              <option value="1">Myself</option>
              <option value="2">Son</option>
              <option value="3">Daughter</option>
              <option value="4">Brother</option>
              <option value="5">Sister</option>
              <option value="6">Relative / Friend</option>
            </select>
          </div>

          <!-- Email & Phone Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="space-y-1.5">
              <label class="text-xs font-bold text-navy-700">Official Email</label>
              <input 
                type="email" 
                id="reg-email"
                required 
                autocomplete="email"
                placeholder="doctor@hospital.org"
                class="w-full px-4 py-3 rounded-2xl text-xs bg-slate-50 border border-slate-200 focus:bg-white focus:border-brand-500 outline-none text-navy-900"
              />
            </div>

            <div class="space-y-1.5">
              <label class="text-xs font-bold text-navy-700">WhatsApp / Mobile Number</label>
              <input 
                type="tel" 
                id="reg-phone"
                required 
                autocomplete="tel"
                placeholder="0300 1234567"
                class="w-full px-4 py-3 rounded-2xl text-xs bg-slate-50 border border-slate-200 focus:bg-white focus:border-brand-500 outline-none text-navy-900"
              />
            </div>
          </div>

          <!-- Password -->
          <div class="space-y-1.5">
            <label class="text-xs font-bold text-navy-700">Create Secure Password</label>
            <div class="relative">
              <input 
                type="password" 
                id="reg-password"
                required 
                minlength="8"
                autocomplete="new-password"
                placeholder="Min 8 characters with numbers"
                class="w-full pl-10 pr-4 py-3 rounded-2xl text-xs bg-slate-50 border border-slate-200 focus:bg-white focus:border-brand-500 outline-none text-navy-900"
              />
              <Lock className="w-4 h-4 text-navy-400 absolute left-3.5 top-1/2 -translate-y-1/2" />
            </div>
          </div>

          <!-- Referral Code (optional) -->
          <div class="space-y-1.5">
            <label class="text-xs font-bold text-navy-700">Referral Code <span class="font-medium text-navy-400">(optional)</span></label>
            <input 
              type="text" 
              id="reg-referral"
              placeholder="e.g. DR4X7B2A"
              class="w-full px-4 py-3 rounded-2xl text-xs bg-slate-50 border border-slate-200 focus:bg-white focus:border-brand-500 outline-none text-navy-900"
            />
          </div>

          <!-- Submit Button -->
          <button 
            type="submit"
            id="reg-submit"
            class="w-full py-3.5 px-6 rounded-2xl bg-gradient-to-r from-brand-500 to-brand-600 hover:from-brand-600 hover:to-brand-700 text-white text-xs font-bold shadow-lg shadow-brand-500/25 hover:shadow-xl hover:shadow-brand-500/35 transition-all transform hover:-translate-y-0.5 flex items-center justify-center gap-2 mt-4 disabled:opacity-60 disabled:cursor-not-allowed disabled:transform-none"
          >
            <span>Create My Doctor Profile</span>
            <ArrowRight className="w-4 h-4" />
          </button>

        </form>

        <!-- Existing Member Login Link -->
        <div class="text-center pt-2">
          <p class="text-xs text-navy-600">
            Already registered? 
            <a href="/login/" class="font-bold text-brand-600 hover:text-brand-700 underline ml-1">
              Sign In Here
            </a>
          </p>
        </div>

      </div>

      <!-- Trust Badges -->
      <div class="flex items-center justify-center gap-6 text-xs text-navy-500">
        <div class="flex items-center gap-1.5">
          <CheckCircle2 className="w-4 h-4 text-emerald-500" />
          <span>100% Halal & Verified</span>
        </div>
        <div class="flex items-center gap-1.5">
          <ShieldCheck className="w-4 h-4 text-emerald-500" />
          <span>Doctor Credentials Only</span>
        </div>
      </div>

    </div>
  </div>

  <script>
    import { api, errorMessage } from '../lib/dashboard/common';

    const form = document.getElementById('reg-form') as HTMLFormElement;
    const errBox = document.getElementById('reg-error') as HTMLElement;
    const submitBtn = document.getElementById('reg-submit') as HTMLButtonElement;

    if (localStorage.getItem('auth_token')) {
      window.location.replace('/dashboard/');
    }

    const val = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLSelectElement).value.trim();

    form?.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      errBox.classList.add('hidden');
      submitBtn.disabled = true;

      const payload = {
        first_name: val('reg-first-name'),
        last_name: val('reg-last-name'),
        email: val('reg-email'),
        phone: val('reg-phone'),
        password: val('reg-password'),
        gender: val('reg-gender'),
        birthday: val('reg-birthday') || null,
        on_behalf_id: Number(val('reg-on-behalf')) || 1,
        referral_code: val('reg-referral'),
      };

      try {
        const res = await api.post('/auth/signup', payload);
        const data = res.data?.data;
        const token = data?.token;
        if (token) {
          localStorage.setItem('auth_token', token);
          if (data?.user) sessionStorage.setItem('dmb_me', JSON.stringify(data.user));
          window.location.href = '/profile/edit/';
        } else {
          sessionStorage.setItem('auth_error', 'Account created — please sign in to continue.');
          window.location.href = '/login/';
        }
      } catch (err) {
        errBox.textContent = errorMessage(err, 'Registration failed. Please review your details and try again.');
        errBox.classList.remove('hidden');
        submitBtn.disabled = false;
      }
    });
  </script>
</PublicLayout>
