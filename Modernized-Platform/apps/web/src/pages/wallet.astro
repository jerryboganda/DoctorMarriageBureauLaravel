---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { Plus, History } from 'lucide-react';
---

<DashboardLayout
  title="Doctor Wallet & Billing — Doctor Marriage Bureau"
  description="Manage matrimonial credit balance, package subscriptions, and payment receipts."
>
  <div class="space-y-8 animate-fadeIn max-w-4xl">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-black text-navy-800 font-serif">
          Doctor <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-500 via-brand-600 to-pink-600">Wallet & Credits</span>
        </h1>
        <p class="text-xs sm:text-sm text-navy-500">Live balance, subscription quota, and payment history</p>
      </div>
      <button id="topup-btn" class="py-2.5 px-4 rounded-full bg-gradient-to-r from-brand-500 via-brand-600 to-pink-600 text-white text-xs font-bold shadow-lg shadow-brand-500/30 flex items-center gap-1.5">
        <Plus className="w-4 h-4" /><span>Top-Up Balance</span>
      </button>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="p-6 rounded-3xl bg-gradient-to-br from-navy-950 via-navy-900 to-brand-950 text-white shadow-luxury">
        <span class="text-[11px] font-semibold text-white/70 uppercase tracking-wider">Available Balance</span>
        <h3 id="wal-balance" class="text-2xl font-bold text-white mt-1">—</h3>
      </div>
      <div class="p-6 rounded-3xl bg-white border border-brand-100/80 shadow-luxury">
        <span class="text-[11px] font-bold text-navy-400 uppercase tracking-wider">Active Plan</span>
        <h3 id="wal-plan" class="text-xl font-bold text-navy-800 mt-1">—</h3>
        <p id="wal-plan-sub" class="text-[11px] text-brand-600 font-semibold mt-1"></p>
      </div>
      <div class="p-6 rounded-3xl bg-white border border-brand-100/80 shadow-luxury">
        <span class="text-[11px] font-bold text-navy-400 uppercase tracking-wider">Remaining Quota</span>
        <h3 id="wal-quota" class="text-xl font-bold text-emerald-600 mt-1">—</h3>
        <p id="wal-exp" class="text-[11px] text-navy-500 mt-1"></p>
      </div>
    </div>

    <div id="topup-panel" class="hidden p-6 rounded-3xl bg-white border border-brand-100/80 shadow-luxury space-y-3">
      <h3 class="text-sm font-bold text-navy-800">Top up wallet</h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <input id="topup-amount" type="number" min="500" step="500" placeholder="Amount (PKR)" class="px-4 py-3 rounded-2xl text-xs bg-navy-50 border border-navy-200" />
        <select id="topup-method" class="px-4 py-3 rounded-2xl text-xs bg-navy-50 border border-navy-200">
          <option value="jazzcash">JazzCash</option>
          <option value="easypaisa">EasyPaisa</option>
          <option value="bank">Bank Transfer</option>
        </select>
        <input id="topup-ref" type="text" placeholder="Transaction / ref ID" class="px-4 py-3 rounded-2xl text-xs bg-navy-50 border border-navy-200" />
      </div>
      <button id="topup-submit" class="px-5 py-2.5 rounded-full bg-navy-800 text-white text-xs font-bold">Submit Top-Up</button>
    </div>

    <div class="p-6 sm:p-8 rounded-3xl bg-white border border-brand-100/80 shadow-luxury space-y-6">
      <h3 class="text-base font-bold text-navy-800 flex items-center gap-2">
        <History className="w-5 h-5 text-brand-500" /><span>Recent Transactions & Billing</span>
      </h3>
      <div id="wal-history" class="divide-y divide-navy-100"></div>
    </div>
  </div>
</DashboardLayout>

<script>
  import { api, escapeHtml, formatPKR, formatDate, toast, errorMessage, emptyStateHtml, errorStateHtml, skeletonHtml } from '../lib/dashboard/common';

  const hist = document.getElementById('wal-history')!;
  hist.innerHTML = skeletonHtml(3, 'h-16');

  Promise.all([
    api.get('/payments/wallet'),
    api.get('/payments/subscription'),
    api.get('/payments/history'),
  ]).then(([w, s, h]) => {
    const wallet = w.data?.data ?? {};
    const sub = s.data?.data ?? {};
    document.getElementById('wal-balance')!.textContent = formatPKR(wallet.balance);
    document.getElementById('wal-plan')!.textContent = sub.package?.name || 'Free Starter';
    document.getElementById('wal-plan-sub')!.textContent = sub.is_active ? 'Active membership' : 'Inactive';
    const remaining = sub.remaining_interest ?? sub.remaining_proposal ?? '—';
    document.getElementById('wal-quota')!.textContent = String(remaining);
    document.getElementById('wal-exp')!.textContent = sub.package_validity ? `Valid ${formatDate(sub.package_validity)}` : '';

    const rows = (h.data?.data ?? []) as any[];
    if (!rows.length) {
      hist.innerHTML = emptyStateHtml('No transactions yet', 'Membership payments and wallet top-ups will appear here.', '💳');
      return;
    }
    hist.innerHTML = rows.map((t) => {
      const amount = Number(t.amount ?? t.final_price ?? 0);
      const credit = String(t.type || t.direction || '').includes('credit') || String(t.kind || '').includes('topup') || amount > 0 && String(t.status).includes('wallet');
      return `
        <div class="py-4 flex items-center justify-between gap-4">
          <div>
            <h4 class="text-xs sm:text-sm font-bold text-navy-800">${escapeHtml(t.description || t.package_name || t.method || 'Payment')}</h4>
            <p class="text-[11px] text-navy-400">${escapeHtml(t.transaction_id || t.ref_id || t.id || '')} · ${formatDate(t.created_at)}</p>
          </div>
          <div class="text-right">
            <span class="text-xs font-bold ${credit ? 'text-emerald-600' : 'text-navy-800'}">${credit ? '+' : ''} ${formatPKR(Math.abs(amount))}</span>
            <span class="block text-[10px] font-bold text-navy-500">${escapeHtml(t.status || 'completed')}</span>
          </div>
        </div>`;
    }).join('');
  }).catch((err) => {
    hist.innerHTML = errorStateHtml(errorMessage(err));
  });

  document.getElementById('topup-btn')!.addEventListener('click', () => {
    document.getElementById('topup-panel')!.classList.toggle('hidden');
  });
  document.getElementById('topup-submit')!.addEventListener('click', async () => {
    const amount = Number((document.getElementById('topup-amount') as HTMLInputElement).value);
    const method = (document.getElementById('topup-method') as HTMLSelectElement).value;
    const ref_id = (document.getElementById('topup-ref') as HTMLInputElement).value;
    if (!amount || amount < 100) { toast('Enter a valid amount.', 'error'); return; }
    try {
      await api.post('/payments/wallet/topup', { amount, method, ref_id });
      toast('Top-up submitted.', 'success');
      location.reload();
    } catch (err) {
      toast(errorMessage(err), 'error');
    }
  });
</script>