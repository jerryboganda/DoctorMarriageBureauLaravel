---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { 
  ShieldCheck, 
  ShieldAlert, 
  Search, 
  Filter, 
  ExternalLink, 
  Check, 
  X, 
  Eye, 
  FileText,
  Clock,
  Award,
  ChevronRight,
  AlertCircle,
  FileQuestion,
  ImageOff
} from 'lucide-react';
---

<AdminLayout title="PMDC Medical License Verifications — DMB Admin" activePath="/admin/verifications/">
  
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-1">
        <a href="/admin/" class="hover:text-navy-900 transition-colors">Admin</a>
        <ChevronRight className="w-3 h-3" />
        <span class="text-navy-900 font-bold">PMDC Verifications</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-black text-navy-900 tracking-tight">PMDC / PMC License Verification</h1>
      <p class="text-xs sm:text-sm text-slate-500 font-medium mt-0.5">
        Audit medical credentials, Pakistan Medical Commission certificates, and GMC registrations to award verified badges.
      </p>
    </div>

    <!-- PMC Official Portal Link -->
    <a 
      href="https://pmc.pakistanmedicalcommission.gov.pk/" 
      target="_blank" 
      rel="noopener noreferrer" 
      class="inline-flex items-center gap-2 px-3.5 py-2.5 rounded-xl text-xs font-bold bg-white text-navy-800 hover:bg-slate-50 border border-slate-200 transition-all shadow-sm"
    >
      <ExternalLink className="w-4 h-4 text-brand-600" />
      <span>Official PMC Verification Portal</span>
    </a>
  </div>

  <!-- Status Tabs -->
  <div class="flex items-center gap-2 p-1.5 rounded-2xl bg-white border border-slate-200 shadow-sm max-w-md">
    <button 
      data-tab="pending" 
      class="flex-1 py-2 px-3 rounded-xl text-xs font-bold bg-brand-500 text-white shadow-sm transition-all tab-btn cursor-pointer"
    >
      Pending Reviews (<span id="count-pending">0</span>)
    </button>
    <button 
      data-tab="approved" 
      class="flex-1 py-2 px-3 rounded-xl text-xs font-bold text-slate-600 hover:text-navy-900 transition-all tab-btn cursor-pointer"
    >
      Approved (<span id="count-approved">0</span>)
    </button>
    <button 
      data-tab="rejected" 
      class="flex-1 py-2 px-3 rounded-xl text-xs font-bold text-slate-600 hover:text-navy-900 transition-all tab-btn cursor-pointer"
    >
      Flagged / Rejected (<span id="count-rejected">0</span>)
    </button>
  </div>

  <!-- Verification Cards Grid -->
  <div id="verifications-grid" class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <!-- Populated by JavaScript -->
    <div class="col-span-2 py-16 text-center text-slate-400 bg-white rounded-2xl border border-slate-200">
      Loading verification queue...
    </div>
  </div>

  <!-- Document Inspection Modal -->
  <div 
    id="modal-inspect-doc" 
    class="fixed inset-0 z-50 bg-navy-950/80 backdrop-blur-sm flex items-center justify-center p-4 hidden"
  >
    <div class="bg-white rounded-2xl border border-slate-200 shadow-2xl max-w-2xl w-full p-6 space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100">
        <div>
          <h3 id="modal-doc-title" class="text-base font-black text-navy-900">PMDC License Document Inspection</h3>
          <p id="modal-doc-sub" class="text-xs text-slate-500">Official medical license certificate submitted for review.</p>
        </div>
        <button id="btn-close-inspect" class="p-1 text-slate-400 hover:text-slate-600 text-lg font-bold cursor-pointer">&times;</button>
      </div>

      <div class="h-80 rounded-xl overflow-hidden bg-slate-100 border border-slate-200 flex items-center justify-center relative">
        <img 
          id="modal-doc-img" 
          src="" 
          alt="License scan" 
          class="w-full h-full object-contain hidden"
        />
        <div id="modal-doc-fallback" class="flex flex-col items-center justify-center p-6 text-center text-slate-400">
          <div class="w-12 h-12 rounded-xl bg-slate-200/80 text-slate-500 flex items-center justify-center mb-2">
            <FileText className="w-6 h-6" />
          </div>
          <p class="text-xs font-bold text-slate-700">No Document File Attached</p>
          <p class="text-[11px] text-slate-400 mt-1 max-w-sm">Candidate has not uploaded a license scan file. You can verify their PMDC number directly via PMC Portal.</p>
        </div>
      </div>

      <div class="flex items-center justify-between pt-2">
        <span id="modal-doc-pmdc" class="font-mono text-xs font-bold text-slate-700 bg-slate-100 px-2.5 py-1 rounded">
          PMC-00000
        </span>
        <div class="flex items-center gap-2">
          <button id="modal-btn-reject" class="px-3.5 py-2 rounded-xl text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200 hover:bg-rose-100 transition-colors cursor-pointer">
            Reject License
          </button>
          <button id="modal-btn-approve" class="px-4 py-2 rounded-xl text-xs font-bold bg-emerald-600 text-white hover:bg-emerald-700 shadow-md shadow-emerald-600/20 transition-colors cursor-pointer">
            Approve & Grant Badge
          </button>
        </div>
      </div>
    </div>
  </div>

</AdminLayout>

<script>
  import { AdminStore, type AdminVerification } from '../../lib/api/admin';
  import { showToast } from '../../lib/toast';

  let currentTab = 'pending';
  let activeModalItem: AdminVerification | null = null;
  let verificationsCache: AdminVerification[] = [];

  function getInitials(name: string): string {
    const parts = (name || 'Doctor').trim().split(/\s+/);
    if (parts.length >= 2) {
      return (parts[0][0] + parts[1][0]).toUpperCase();
    }
    return (name.slice(0, 2) || 'DR').toUpperCase();
  }

  async function renderVerifications() {
    const grid = document.getElementById('verifications-grid');
    if (!grid) return;
    grid.innerHTML = '<div class="col-span-2 py-16 text-center text-slate-400 bg-white rounded-2xl border border-slate-200">Loading live verifications from API...</div>';
    try {
      const list = await AdminStore.getVerifications();
      verificationsCache = list;
      
      // Counts
      const pendingCount = list.filter(v => v.status === 'pending').length;
      const approvedCount = list.filter(v => v.status === 'approved').length;
      const rejectedCount = list.filter(v => v.status === 'rejected').length;

      const elPending = document.getElementById('count-pending');
      if (elPending) elPending.textContent = String(pendingCount);
      const elApproved = document.getElementById('count-approved');
      if (elApproved) elApproved.textContent = String(approvedCount);
      const elRejected = document.getElementById('count-rejected');
      if (elRejected) elRejected.textContent = String(rejectedCount);

      const filtered = list.filter(v => v.status === currentTab);

      if (filtered.length === 0) {
        grid.innerHTML = `<div class="col-span-2 py-16 text-center text-slate-500 bg-white rounded-2xl border border-slate-200">No live data — no ${currentTab} verifications.</div>`;
        return;
      }

      grid.innerHTML = filtered.map(v => {
        const initials = getInitials(v.doctor_name);
        const hasAvatar = v.avatar && v.avatar.trim() !== '' && v.avatar !== 'null';
        const hasDoc = v.document_url && v.document_url.trim() !== '' && v.document_url !== 'null';
        const pmdcClean = (v.pmdc_number && v.pmdc_number.trim() !== '') 
          ? v.pmdc_number 
          : '<span class="text-slate-400 font-normal italic">PMC Not Provided</span>';

        return `
        <div class="p-5 rounded-2xl bg-white border border-slate-200/90 shadow-sm space-y-4 relative group">
          <!-- Header -->
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="relative w-12 h-12 rounded-xl overflow-hidden ring-1 ring-slate-200 bg-gradient-to-tr from-brand-600 via-rose-500 to-pink-600 text-white flex items-center justify-center font-bold text-sm shrink-0">
                ${hasAvatar ? `
                  <img 
                    src="${v.avatar}" 
                    class="w-full h-full object-cover" 
                    alt="${v.doctor_name}" 
                    onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
                  />
                  <span style="display:none;" class="w-full h-full flex items-center justify-center font-bold text-sm tracking-wider uppercase">${initials}</span>
                ` : `
                  <span class="w-full h-full flex items-center justify-center font-bold text-sm tracking-wider uppercase">${initials}</span>
                `}
              </div>
              <div class="min-w-0">
                <a href="/admin/doctors/view/?id=${v.doctor_id}" class="text-sm font-black text-navy-900 hover:text-brand-600 transition-colors block truncate">
                  ${v.doctor_name || 'Unnamed Doctor'}
                </a>
                <p class="text-xs text-slate-600 font-semibold truncate">${v.speciality || 'General Medicine'}</p>
                <p class="text-[10px] text-slate-400 truncate">${v.hospital || 'Hospital'} • ${v.city || 'Pakistan'}</p>
              </div>
            </div>

            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold shrink-0 ${
              v.status === 'approved' 
                ? 'bg-emerald-100 text-emerald-700' 
                : v.status === 'pending' 
                ? 'bg-amber-100 text-amber-700 animate-pulse' 
                : 'bg-rose-100 text-rose-700'
            }">
              ${v.status.toUpperCase()}
            </span>
          </div>

          <!-- License Info -->
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between text-xs">
            <div>
              <span class="text-[10px] font-bold uppercase text-slate-400 block">${v.document_type || 'PMDC License'}</span>
              <span class="font-mono font-black text-navy-900 text-sm">${pmdcClean}</span>
            </div>
            <span class="text-[11px] text-slate-400 font-medium">${v.submitted_at || 'Recently'}</span>
          </div>

          <!-- Document Preview Thumbnail / Card -->
          ${hasDoc ? `
            <div class="relative h-44 rounded-xl overflow-hidden bg-slate-100 border border-slate-200 group/img flex items-center justify-center">
              <img 
                src="${v.document_url}" 
                alt="License scan" 
                class="w-full h-full object-cover group-hover/img:scale-105 transition-transform duration-300"
                onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
              />
              
              <!-- Fallback if uploaded file is missing from server -->
              <div style="display:none;" class="w-full h-full flex flex-col items-center justify-center p-4 text-center bg-slate-50">
                <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center mb-1.5">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                </div>
                <p class="text-xs font-bold text-slate-700">Document Scan Unreachable</p>
                <p class="text-[10px] text-slate-400 mt-0.5 font-mono truncate max-w-xs">${v.document_url}</p>
                <a href="${v.document_url}" target="_blank" class="mt-2 text-[10px] font-bold text-brand-600 underline">Open File Directly</a>
              </div>

              <!-- Overlay on hover for inspection -->
              <div class="absolute inset-0 bg-navy-950/40 opacity-0 group-hover/img:opacity-100 transition-opacity flex items-center justify-center gap-2">
                <button 
                  data-action="inspect-doc" 
                  data-id="${v.id}"
                  class="px-3.5 py-1.5 rounded-lg bg-white text-xs font-bold text-navy-900 shadow-md flex items-center gap-1.5 hover:bg-slate-50 transition-colors cursor-pointer"
                >
                  <span>Inspect Full Resolution</span>
                </button>
                <a 
                  href="${v.document_url}" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="p-1.5 rounded-lg bg-white/90 text-navy-900 hover:bg-white transition-colors"
                  title="Open original image in new tab"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                </a>
              </div>
            </div>
          ` : `
            <div class="h-44 rounded-xl overflow-hidden bg-gradient-to-b from-slate-50 to-slate-100/70 border border-dashed border-slate-200 flex flex-col items-center justify-center p-4 text-center">
              <div class="w-10 h-10 rounded-xl bg-slate-200/80 text-slate-500 flex items-center justify-center mb-2 shadow-xs">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              </div>
              <p class="text-xs font-bold text-slate-700">No License Scan Uploaded</p>
              <p class="text-[10px] text-slate-400 mt-0.5 max-w-xs">Candidate registered without attaching PMDC certificate scan.</p>
              <div class="mt-2.5 flex items-center gap-2">
                <a 
                  href="/admin/doctors/view/?id=${v.doctor_id}" 
                  class="px-2.5 py-1 rounded-lg text-[10px] font-bold bg-white text-navy-800 border border-slate-200 hover:bg-slate-50 shadow-xs transition-colors"
                >
                  View Profile
                </a>
                <button 
                  data-action="inspect-doc" 
                  data-id="${v.id}"
                  class="px-2.5 py-1 rounded-lg text-[10px] font-bold bg-slate-200/80 text-slate-700 hover:bg-slate-300 transition-colors cursor-pointer"
                >
                  Review Details
                </button>
              </div>
            </div>
          `}

          <!-- Review Actions -->
          <div class="flex items-center justify-between pt-2 border-t border-slate-100">
            <a 
              href="https://pmc.pakistanmedicalcommission.gov.pk/" 
              target="_blank" 
              class="text-[11px] font-bold text-brand-600 hover:text-brand-700 flex items-center gap-1"
            >
              <span>PMC Online Check</span>
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>

            ${v.status === 'pending' ? `
              <div class="flex items-center gap-2">
                <button 
                  data-action="reject-verif" 
                  data-id="${v.id}"
                  class="px-3 py-1.5 rounded-lg text-xs font-bold bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 transition-colors cursor-pointer"
                >
                  Reject
                </button>
                <button 
                  data-action="approve-verif" 
                  data-id="${v.id}"
                  class="px-3.5 py-1.5 rounded-lg text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm transition-colors flex items-center gap-1 cursor-pointer"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  <span>Approve Badge</span>
                </button>
              </div>
            ` : `
              <span class="text-xs text-slate-400 font-medium">
                ${v.status === 'approved' ? `Approved on ${v.reviewed_at || 'Recently'}` : `Rejected: ${v.rejection_reason || 'Invalid license image'}`}
              </span>
            `}
          </div>
        </div>
        `;
      }).join('');

      // Bind action events (re-bound after render)
      document.querySelectorAll('[data-action="approve-verif"]').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          const id = Number((e.currentTarget as HTMLElement).getAttribute('data-id'));
          try {
            await AdminStore.reviewVerification(id, 'approved');
            showToast({
              title: 'PMDC License Verified',
              message: 'Official verified badge granted to doctor.',
              type: 'verification'
            });
            await renderVerifications();
          } catch (err: any) {
            showToast({ title: 'Approval failed', message: err?.response?.data?.message || err?.message || 'Failed to approve verification.', type: 'error' });
          }
        });
      });

      document.querySelectorAll('[data-action="reject-verif"]').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          const id = Number((e.currentTarget as HTMLElement).getAttribute('data-id'));
          const reason = prompt('Enter rejection reason for doctor (e.g., Unclear photograph, License expired):');
          if (reason) {
            try {
              await AdminStore.reviewVerification(id, 'rejected', reason);
              showToast({
                title: 'Verification Rejected',
                message: 'Feedback sent to doctor.',
                type: 'warning'
              });
              await renderVerifications();
            } catch (err: any) {
              showToast({ title: 'Rejection failed', message: err?.response?.data?.message || err?.message || 'Failed to reject verification.', type: 'error' });
            }
          }
        });
      });

      document.querySelectorAll('[data-action="inspect-doc"]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const id = Number((e.currentTarget as HTMLElement).getAttribute('data-id'));
          const item = verificationsCache.find(v => v.id === id);
          if (item) {
            activeModalItem = item;
            const modal = document.getElementById('modal-inspect-doc');
            const title = document.getElementById('modal-doc-title');
            const sub = document.getElementById('modal-doc-sub');
            const img = document.getElementById('modal-doc-img') as HTMLImageElement;
            const fallback = document.getElementById('modal-doc-fallback');
            const pmdc = document.getElementById('modal-doc-pmdc');

            if (title) title.textContent = `${item.doctor_name || 'Doctor'} — ${item.document_type || 'PMDC License'}`;
            if (sub) sub.textContent = `${item.speciality || 'General Medicine'} • ${item.hospital || 'Hospital'}`;
            if (pmdc) pmdc.textContent = item.pmdc_number || 'PMC Not Provided';

            if (img && fallback) {
              if (item.document_url && item.document_url.trim() !== '' && item.document_url !== 'null') {
                img.src = item.document_url;
                img.onload = () => {
                  img.classList.remove('hidden');
                  fallback.classList.add('hidden');
                };
                img.onerror = () => {
                  img.classList.add('hidden');
                  fallback.classList.remove('hidden');
                };
              } else {
                img.classList.add('hidden');
                fallback.classList.remove('hidden');
              }
            }

            modal?.classList.remove('hidden');
          }
        });
      });
    } catch (err: any) {
      grid.innerHTML = `<div class="col-span-2 py-16 text-center text-rose-600 bg-white rounded-2xl border border-rose-200">${err?.response?.data?.message || err?.message || 'Failed to load live verifications. Please retry.'}</div>`;
    }
  }

  async function initVerifications() {
    // Tab switching
    document.querySelectorAll('.tab-btn').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const tab = (e.currentTarget as HTMLElement).getAttribute('data-tab');
        if (!tab) return;
        currentTab = tab;

        document.querySelectorAll('.tab-btn').forEach((b) => {
          b.className = 'flex-1 py-2 px-3 rounded-xl text-xs font-bold text-slate-600 hover:text-navy-900 transition-all tab-btn cursor-pointer';
        });

        (e.currentTarget as HTMLElement).className = 'flex-1 py-2 px-3 rounded-xl text-xs font-bold bg-brand-500 text-white shadow-sm transition-all tab-btn cursor-pointer';
        await renderVerifications();
      });
    });

    // Inspect Modal Buttons
    const modal = document.getElementById('modal-inspect-doc');
    document.getElementById('btn-close-inspect')?.addEventListener('click', () => modal?.classList.add('hidden'));

    document.getElementById('modal-btn-approve')?.addEventListener('click', async () => {
      if (activeModalItem) {
        try {
          await AdminStore.reviewVerification(activeModalItem.id, 'approved');
          modal?.classList.add('hidden');
          showToast({
            title: 'PMDC License Verified',
            message: 'Official verified badge granted to doctor.',
            type: 'verification'
          });
          await renderVerifications();
        } catch (err: any) {
          showToast({ title: 'Approval failed', message: err?.response?.data?.message || err?.message || 'Failed to approve verification.', type: 'error' });
        }
      }
    });

    document.getElementById('modal-btn-reject')?.addEventListener('click', async () => {
      if (activeModalItem) {
        const reason = prompt('Enter rejection reason for doctor:');
        if (reason) {
          try {
            await AdminStore.reviewVerification(activeModalItem.id, 'rejected', reason);
            modal?.classList.add('hidden');
            showToast({
              title: 'Verification Rejected',
              message: 'Feedback sent to doctor.',
              type: 'warning'
            });
            await renderVerifications();
          } catch (err: any) {
            showToast({ title: 'Rejection failed', message: err?.response?.data?.message || err?.message || 'Failed to reject verification.', type: 'error' });
          }
        }
      }
    });

    await renderVerifications();
  }

  document.addEventListener('DOMContentLoaded', initVerifications);
  document.addEventListener('astro:page-load', initVerifications);
</script>
