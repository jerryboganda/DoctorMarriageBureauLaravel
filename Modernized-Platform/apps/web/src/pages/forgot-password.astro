---
import Layout from '../layouts/Layout.astro';
import { 
  KeyRound, 
  Mail, 
  ArrowRight, 
  ShieldCheck, 
  Sparkles,
  ArrowLeft,
  CheckCircle2
} from 'lucide-react';
---

<Layout 
  title="Forgot Password — Doctor Marriage Bureau"
  description="Reset your doctor matrimonial portal account password with verified OTP."
>
  <section class="min-h-[85vh] py-16 flex items-center justify-center bg-gradient-to-b from-[#FAFAFD] via-brand-50/30 to-[#FAFAFD] relative overflow-hidden">
    
    <!-- Background Glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-brand-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-md mx-auto px-4 relative z-10 animate-fadeIn">
      
      <!-- Card -->
      <div class="p-8 sm:p-10 rounded-3xl bg-white border border-brand-100/80 shadow-luxury space-y-6">
        
        <!-- Header -->
        <div class="text-center space-y-2">
          <div class="inline-flex p-3 rounded-2xl bg-brand-50 text-brand-600 mb-1">
            <KeyRound className="w-8 h-8" />
          </div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-navy-900 font-serif">
            Reset <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-500 to-pink-500">Password</span>
          </h1>
          <p class="text-xs text-navy-500">
            Enter your registered email address or phone number to receive a 6-digit recovery code.
          </p>
        </div>

        <!-- Form -->
        <form class="space-y-4" onsubmit="event.preventDefault(); alert('A 6-digit recovery OTP has been dispatched to your email and phone.'); window.location.href = '/login/';">
          
          <div class="space-y-1.5">
            <label class="text-xs font-bold text-navy-700">Email Address / Phone Number</label>
            <div class="relative">
              <input 
                type="text" 
                required
                placeholder="doctor@medical.org or 0300 1234567"
                class="w-full pl-10 pr-4 py-3 rounded-2xl text-xs bg-slate-50 border border-slate-200 outline-none focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 text-navy-900 transition-all"
              />
              <Mail className="w-4 h-4 text-navy-400 absolute left-3.5 top-1/2 -translate-y-1/2" />
            </div>
          </div>

          <button 
            type="submit"
            class="w-full py-3.5 px-4 rounded-2xl text-xs font-bold text-white bg-gradient-to-r from-brand-500 via-brand-600 to-pink-600 hover:from-brand-600 hover:to-pink-700 shadow-lg shadow-brand-500/25 transition-all flex items-center justify-center gap-2"
          >
            <span>Send Recovery OTP</span>
            <ArrowRight className="w-4 h-4" />
          </button>
        </form>

        <!-- Back to Login -->
        <div class="pt-4 border-t border-slate-100 text-center">
          <a 
            href="/login/" 
            class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-600 hover:text-brand-700 transition-colors"
          >
            <ArrowLeft className="w-3.5 h-3.5" />
            <span>Back to Login</span>
          </a>
        </div>

      </div>

    </div>
  </section>
</Layout>
