---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { 
  Sparkles, 
  Plus, 
  Check, 
  X, 
  Star, 
  ChevronRight,
  Heart,
  Eye
} from 'lucide-react';
---

<AdminLayout title="Success Stories & Testimonials — DMB Admin" activePath="/admin/happy-stories/">
  
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-1">
        <a href="/admin/" class="hover:text-navy-900 transition-colors">Admin</a>
        <ChevronRight className="w-3 h-3" />
        <span class="text-navy-900 font-bold">Success Stories</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-black text-navy-900 tracking-tight">Doctor Wedding Stories</h1>
      <p class="text-xs sm:text-sm text-slate-500 font-medium mt-0.5">
        Moderate verified doctor marriage testimonials and feature them across the landing and member experience.
      </p>
    </div>

    <!-- Actions -->
    <button 
      id="btn-add-story" 
      class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-bold bg-brand-500 text-white hover:bg-brand-600 shadow-md shadow-brand-500/20 transition-all"
    >
      <Plus className="w-4 h-4" />
      <span>Add New Success Story</span>
    </button>
  </div>

  <!-- Stories Grid -->
  <div id="stories-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Populated by JavaScript -->
    <div class="col-span-2 py-16 text-center text-slate-400 bg-white rounded-2xl border border-slate-200">
      Loading success stories...
    </div>
  </div>

</AdminLayout>

<script>
  import { AdminStore, type AdminHappyStory } from '../../lib/api/admin';
  import { showToast } from '../../lib/toast';

  let storiesCache: AdminHappyStory[] = [];

  async function renderStories() {
    const grid = document.getElementById('stories-grid');
    if (!grid) return;
    grid.innerHTML = '<div class="col-span-2 py-16 text-center text-slate-400 bg-white rounded-2xl border border-slate-200">Loading live success stories from API...</div>';
    try {
      const list = await AdminStore.getHappyStories();
      storiesCache = list;

      if (!list.length) {
        grid.innerHTML = '<div class="col-span-2 py-16 text-center text-slate-500 bg-white rounded-2xl border border-slate-200">No live data — no success stories yet.</div>';
        return;
      }

      grid.innerHTML = list.map(s => `
      <div class="p-6 rounded-2xl bg-white border border-slate-200/90 shadow-sm space-y-4 relative">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="p-2 rounded-xl bg-rose-50 text-rose-600">
              <Heart className="w-5 h-5" />
            </div>
            <div>
              <h3 class="text-base font-black text-navy-900">${s.couple_title}</h3>
              <p class="text-xs text-slate-500 font-semibold">${s.city} • Married ${s.marriage_date}</p>
            </div>
          </div>
          <span class="px-2.5 py-1 rounded-full text-[10px] font-bold ${
            s.status === 'approved' ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700'
          }">
            ${s.status.toUpperCase()}
          </span>
        </div>
        <div class="relative h-48 rounded-xl overflow-hidden bg-slate-100 border border-slate-200">
          <img src="${s.photo_url}" alt="${s.couple_title}" class="w-full h-full object-cover" />
        </div>
        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 space-y-2 text-xs">
          <p class="text-slate-700 font-semibold">
            👨‍⚕️ <strong>Groom:</strong> ${s.groom_name} (${s.groom_specialty})
          </p>
          <p class="text-slate-700 font-semibold">
            👩‍⚕️ <strong>Bride:</strong> ${s.bride_name} (${s.bride_specialty})
          </p>
        </div>
        <p class="text-xs text-slate-600 italic leading-relaxed">
          "${s.story}"
        </p>
        <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
          <label class="flex items-center gap-2 text-xs font-bold text-slate-700 cursor-pointer">
            <input 
              type="checkbox" 
              data-action="toggle-feature" 
              data-id="${s.id}" 
              ${s.is_featured ? 'checked' : ''} 
              class="w-4 h-4 rounded text-brand-500 focus:ring-brand-400"
            />
            <span>Feature on Homepage</span>
          </label>
          <div class="flex items-center gap-2">
            ${s.status !== 'approved' ? `
              <button 
                data-action="approve-story" 
                data-id="${s.id}"
                class="px-3 py-1.5 rounded-xl text-xs font-bold bg-emerald-600 text-white hover:bg-emerald-700 transition-colors"
              >
                Publish Story
              </button>
            ` : `
              <span class="text-xs text-emerald-600 font-bold">✓ Published</span>
            `}
          </div>
        </div>
      </div>
    `).join('');

      // Bind action events (re-bound after render)
      document.querySelectorAll('[data-action="approve-story"]').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          const id = Number((e.currentTarget as HTMLElement).getAttribute('data-id'));
          try {
            await AdminStore.reviewHappyStory(id, 'approved', true);
            showToast({
              title: 'Success Story Published',
              message: 'Story is now visible on public landing page.',
              type: 'info'
            });
            await renderStories();
          } catch (err: any) {
            showToast({ title: 'Publish failed', message: err?.response?.data?.message || err?.message || 'Failed to publish story.', type: 'error' });
          }
        });
      });

      document.querySelectorAll('[data-action="toggle-feature"]').forEach((chk) => {
        chk.addEventListener('change', async (e) => {
          const id = Number((e.currentTarget as HTMLElement).getAttribute('data-id'));
          const isChecked = (e.currentTarget as HTMLInputElement).checked;
          const story = storiesCache.find(s => s.id === id);
          if (story) {
            try {
              await AdminStore.reviewHappyStory(id, story.status, isChecked);
              showToast({
                title: isChecked ? 'Featured on Homepage' : 'Removed from Featured',
                message: 'Homepage display preference updated.',
                type: 'info'
              });
              // Update cache optimistically and keep UI in sync without full reload
              story.is_featured = isChecked;
            } catch (err: any) {
              // revert checkbox on failure
              (e.currentTarget as HTMLInputElement).checked = !isChecked;
              showToast({ title: 'Update failed', message: err?.response?.data?.message || err?.message || 'Failed to update featured flag.', type: 'error' });
            }
          }
        });
      });
    } catch (err: any) {
      grid.innerHTML = `<div class="col-span-2 py-16 text-center text-rose-600 bg-white rounded-2xl border border-rose-200">${err?.response?.data?.message || err?.message || 'Failed to load live stories. Please retry.'}</div>`;
    }
  }

  async function initStories() {
    await renderStories();

    document.getElementById('btn-add-story')?.addEventListener('click', async () => {
      const groom = prompt('Groom Name & Degree (e.g. Dr. Hammad, FCPS):');
      const bride = prompt('Bride Name & Degree (e.g. Dr. Zainab, MBBS):');
      if (groom && bride) {
        // Creation is now API-driven — no localStorage or seed mutation.
        // The backend currently exposes reviewHappyStory for moderation; creation via POST /admin/happy-stories
        // will be added when API supports it. For now, reload live data and inform admin.
        showToast({
          title: 'Create via API',
          message: 'New story creation is API-driven. Please use the backend when POST /admin/happy-stories is available. Reloading live data.',
          type: 'info'
        });
        try {
          await renderStories();
        } catch {}
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initStories);
  document.addEventListener('astro:page-load', initStories);
</script>
