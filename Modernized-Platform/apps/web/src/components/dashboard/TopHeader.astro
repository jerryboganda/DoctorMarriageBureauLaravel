---
import { 
  Search, 
  Bell, 
  ShieldCheck, 
  ChevronDown, 
  Menu, 
  User, 
  Settings, 
  HeartHandshake, 
  LogOut,
  Sparkles,
  Crown
} from 'lucide-react';
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-brand-100/80 shadow-sm h-20 transition-all duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full flex items-center justify-between gap-4">
    
    <!-- Brand Logo & Mobile Toggle -->
    <div class="flex items-center gap-4">
      <button 
        id="dashboard-mobile-toggle"
        class="lg:hidden p-2 rounded-xl text-navy-700 hover:bg-brand-50 hover:text-brand-600 transition-colors"
        aria-label="Toggle Navigation Menu"
      >
        <Menu className="w-6 h-6" />
      </button>

      <a href="/dashboard/" class="flex items-center gap-3 group">
        <img 
          src="/images/logo.png" 
          alt="Doctor Marriage Bureau Logo" 
          class="h-10 sm:h-11 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
          width="160"
          height="44"
          loading="eager"
        />
      </a>
    </div>

    <!-- Universal Search Bar -->
    <div class="hidden md:flex items-center flex-1 max-w-md mx-4">
      <div class="relative w-full">
        <input 
          type="text" 
          data-dmb-header-search
          placeholder="Search by specialty (e.g. Cardiologist, Surgeon, MBBS, BDS) or city..."
          class="w-full pl-10 pr-4 py-2.5 rounded-full text-xs bg-navy-50 border border-navy-200/80 focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 text-navy-800 transition-all outline-none"
        />
        <Search className="w-4 h-4 text-navy-400 absolute left-3.5 top-1/2 -translate-y-1/2" />
      </div>
    </div>

    <!-- Quick Action Icons & Profile Drawer -->
    <div class="flex items-center gap-2 sm:gap-3">
      
      <!-- Admin Control Center Shortcut (shown only for admin) -->
      <a 
        href="/admin/" 
        data-dmb-admin-link
        class="hidden items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold text-white bg-slate-950 hover:bg-slate-900 border border-slate-800 shadow-sm transition-all"
        title="Open Admin Control Center"
      >
        <ShieldCheck className="w-3.5 h-3.5 text-brand-400" />
        <span>Admin Portal</span>
      </a>

      <!-- Upgrade VIP Pill -->
      <a 
        href="/packages/" 
        class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-bold text-gold-dark bg-gold-light/50 border border-gold/60 hover:bg-gold-light/70 transition-all"
      >
        <Crown className="w-3.5 h-3.5 text-gold-dark" />
        <span>Upgrade VIP</span>
      </a>

      <!-- Notifications Bell -->
      <div class="relative">
        <a 
          href="/notifications/"
          class="p-2.5 rounded-full text-navy-600 hover:text-brand-600 hover:bg-brand-50/80 transition-colors relative block"
          title="Notifications"
        >
          <Bell className="w-5 h-5" />
          <span data-dmb-unread-badge class="hidden absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] px-1 bg-brand-500 rounded-full ring-2 ring-white text-white text-[9px] font-bold flex items-center justify-center leading-none">
            <span data-dmb-unread-count>0</span>
          </span>
        </a>
      </div>

      <!-- User Dropdown Trigger -->
      <div class="relative group">
        <button 
          class="flex items-center gap-2 p-1.5 rounded-full hover:bg-brand-50/80 transition-colors outline-none"
          id="user-menu-button"
          aria-expanded="false"
        >
          <div class="w-9 h-9 rounded-full overflow-hidden border border-brand-300 shadow-sm bg-navy-100">
            <img 
              src="/assets/img/avatar-place.png" 
              data-dmb-avatar
              alt="Avatar" 
              class="w-full h-full object-cover"
            />
          </div>
          <ChevronDown className="w-4 h-4 text-navy-400 group-hover:text-brand-600 transition-transform" />
        </button>

        <!-- Dropdown Popover Menu -->
        <div class="absolute right-0 mt-2 w-56 bg-white border border-brand-100 rounded-2xl shadow-luxury p-2 invisible opacity-0 scale-95 group-hover:visible group-hover:opacity-100 group-hover:scale-100 transition-all duration-200 origin-top-right z-50">
          <div class="px-3 py-2 border-b border-brand-50">
            <p data-dmb-user-name class="text-xs font-bold text-navy-800 truncate">&nbsp;</p>
            <p data-dmb-user-email class="text-[11px] text-navy-400 truncate">&nbsp;</p>
          </div>

          <div class="py-1.5 space-y-0.5">
            <a href="/admin/" data-dmb-admin-link class="hidden items-center gap-2.5 px-3 py-2 text-xs font-bold text-brand-600 hover:bg-brand-50 rounded-xl transition-colors">
              <ShieldCheck className="w-4 h-4 text-brand-600" />
              <span>Admin Control Center</span>
            </a>
            <a href="/profile/" class="flex items-center gap-2.5 px-3 py-2 text-xs font-semibold text-navy-700 hover:text-brand-600 hover:bg-brand-50 rounded-xl transition-colors">
              <User className="w-4 h-4" />
              <span>My Profile</span>
            </a>
            <a href="/proposals/" class="flex items-center gap-2.5 px-3 py-2 text-xs font-semibold text-navy-700 hover:text-brand-600 hover:bg-brand-50 rounded-xl transition-colors">
              <HeartHandshake className="w-4 h-4" />
              <span>Proposal Requests</span>
            </a>
            <a href="/settings/" class="flex items-center gap-2.5 px-3 py-2 text-xs font-semibold text-navy-700 hover:text-brand-600 hover:bg-brand-50 rounded-xl transition-colors">
              <Settings className="w-4 h-4" />
              <span>Security & 2FA</span>
            </a>
          </div>

          <div class="pt-1 border-t border-brand-50">
            <a href="/login/" data-dmb-logout class="flex items-center gap-2.5 px-3 py-2 text-xs font-semibold text-brand-700 hover:bg-brand-50 rounded-xl transition-colors">
              <LogOut className="w-4 h-4" />
              <span>Sign Out</span>
            </a>
          </div>
        </div>
      </div>

    </div>

  </div>
</header>
