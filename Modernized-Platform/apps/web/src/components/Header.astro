---
import { Menu, X, User, HeartHandshake, ShieldCheck, ArrowRight } from 'lucide-react';

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about/' },
  { label: 'Packages', href: '/packages/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Contact', href: '/contact/' },
  { label: 'Report Harassment', href: '/report-harrasement/' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-brand-100/50 shadow-sm transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <img 
          src="/images/logo.png" 
          alt="Doctor Marriage Bureau Logo" 
          class="h-12 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
          width="180"
          height="48"
          loading="eager"
        />
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a 
              href={item.href}
              class={`px-3 py-2 rounded-full text-sm font-medium transition-all duration-200 ${
                isActive 
                  ? 'text-brand-600 bg-brand-50 font-semibold' 
                  : 'text-navy-800 hover:text-brand-500 hover:bg-brand-50/50'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Auth Action Buttons -->
      <div class="hidden sm:flex items-center gap-3">
        <a 
          href="/login/" 
          class="px-4 py-2 text-sm font-medium text-navy-800 hover:text-brand-600 transition-colors flex items-center gap-1.5"
        >
          <User className="w-4 h-4 text-navy-500" />
          <span>Login</span>
        </a>
        <a 
          href="/register/" 
          class="px-5 py-2.5 rounded-full text-sm font-semibold text-white bg-gradient-to-r from-brand-500 to-brand-600 hover:from-brand-600 hover:to-brand-700 shadow-md shadow-brand-500/20 hover:shadow-lg hover:shadow-brand-500/30 transition-all duration-300 transform hover:-translate-y-0.5 flex items-center gap-2"
        >
          <span>Find Your Match</span>
          <ArrowRight className="w-4 h-4" />
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <div class="flex items-center sm:hidden">
        <button 
          id="mobile-menu-toggle"
          type="button" 
          class="p-2 rounded-lg text-navy-800 hover:bg-brand-50 focus:outline-none"
          aria-label="Toggle navigation menu"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden sm:hidden bg-white border-b border-brand-100 px-4 pt-2 pb-6 space-y-2 animate-fadeIn">
    {navItems.map((item) => (
      <a 
        href={item.href}
        class="block px-4 py-2.5 rounded-lg text-base font-medium text-navy-900 hover:bg-brand-50 hover:text-brand-600 transition-colors"
      >
        {item.label}
      </a>
    ))}
    <div class="pt-4 border-t border-navy-100 flex flex-col gap-2">
      <a 
        href="/login/" 
        class="w-full text-center py-2.5 rounded-lg text-sm font-semibold text-navy-800 bg-navy-50 hover:bg-navy-100 transition-colors"
      >
        Member Login
      </a>
      <a 
        href="/register/" 
        class="w-full text-center py-2.5 rounded-lg text-sm font-semibold text-white bg-brand-500 hover:bg-brand-600 shadow-md transition-colors"
      >
        Find Your Match — Register
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
