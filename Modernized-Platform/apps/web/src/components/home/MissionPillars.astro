---
import { Search, Tag, ThumbsUp, ArrowRight } from 'lucide-react';

const pillars = [
  {
    number: "01",
    title: "We Locate Doctor Profiles",
    desc: "Our specialized matchmakers personally search and verify compatible doctors, surgeons, specialists, and dental practitioners across Pakistan, UK, USA, Gulf, and Europe based on your religious, family, and educational criteria.",
    icon: Search,
    color: "from-brand-500 to-rose-600",
    bgLight: "bg-brand-50/60"
  },
  {
    number: "02",
    title: "Offer Transparent Packages",
    desc: "We provide highly discounted and transparent membership packages without hidden broker charges or unexpected commissions. Straightforward 3-month (PKR 5,000) and 6-month (PKR 8,000) memberships.",
    icon: Tag,
    color: "from-navy-700 to-navy-900",
    bgLight: "bg-navy-50/60"
  },
  {
    number: "03",
    title: "100% Client Satisfaction",
    desc: "Our team prioritizes dignity, confidentiality, and family satisfaction. Every doctor profile is protected by privacy safeguards and blurred photos until mutual family consent is established.",
    icon: ThumbsUp,
    color: "from-emerald-600 to-teal-700",
    bgLight: "bg-emerald-50/60"
  }
];
---

<section class="py-20 lg:py-24 bg-white relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-3.5 py-1.5 rounded-full text-xs font-semibold text-brand-600 bg-brand-50 border border-brand-100 tracking-wider uppercase mb-3">
        Our Core Purpose
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-navy-900 tracking-tight">
        Dedicated Exclusively To <span class="text-brand-500">Muslim Medical Professionals</span>
      </h2>
      <p class="mt-4 text-base text-navy-600 leading-relaxed">
        We understand the demanding lifestyle, noble aspirations, and specific compatibility needs of doctors. Here is how we make finding your life partner effortless.
      </p>
    </div>

    <!-- 3 Pillar Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-14">
      {pillars.map((pillar) => {
        const IconComponent = pillar.icon;
        return (
          <div class="group relative rounded-3xl p-8 bg-white border border-brand-100/80 shadow-luxury hover:shadow-luxury-hover transition-all duration-300 transform hover:-translate-y-1 flex flex-col justify-between">
            <div class="space-y-6">
              <div class="flex justify-between items-center">
                <div class={`w-14 h-14 rounded-2xl bg-gradient-to-tr ${pillar.color} text-white flex items-center justify-center shadow-md group-hover:scale-110 transition-transform duration-300`}>
                  <IconComponent className="w-7 h-7" />
                </div>
                <span class="text-3xl font-extrabold text-navy-200 group-hover:text-brand-300 transition-colors">
                  {pillar.number}
                </span>
              </div>
              
              <h3 class="text-xl font-bold text-navy-900 group-hover:text-brand-600 transition-colors">
                {pillar.title}
              </h3>
              
              <p class="text-navy-600 text-sm leading-relaxed">
                {pillar.desc}
              </p>
            </div>

            <div class="pt-6 mt-6 border-t border-navy-50 flex items-center text-xs font-semibold text-brand-600 group-hover:translate-x-1 transition-transform">
              <span>Learn more about our standards</span>
              <ArrowRight className="w-3.5 h-3.5 ml-1.5" />
            </div>
          </div>
        );
      })}
    </div>

    <!-- Join Us Today CTA Box -->
    <div class="rounded-3xl bg-gradient-to-r from-navy-900 via-navy-800 to-navy-950 p-8 sm:p-12 text-white flex flex-col md:flex-row items-center justify-between gap-8 shadow-2xl relative overflow-hidden">
      <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-brand-500/20 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="space-y-2 text-center md:text-left z-10">
        <h3 class="text-2xl sm:text-3xl font-extrabold text-white">
          Begin Your Matrimonial Journey with Us Today!
        </h3>
        <p class="text-navy-200 text-sm sm:text-base max-w-2xl">
          Create your verified doctor profile in less than 2 minutes. Confidential, secure, and family-approved.
        </p>
      </div>

      <a 
        href="/register/" 
        class="shrink-0 px-8 py-4 rounded-full text-sm font-bold text-white bg-gradient-to-r from-brand-500 to-brand-600 hover:from-brand-600 hover:to-brand-700 shadow-xl shadow-brand-500/30 transition-all duration-300 transform hover:scale-105 flex items-center gap-2 z-10"
      >
        <span>Join Us Today</span>
        <ArrowRight className="w-4 h-4" />
      </a>
    </div>

  </div>
</section>
