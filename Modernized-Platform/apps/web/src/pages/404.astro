---
import Layout from '../layouts/Layout.astro';
import { Home, ArrowLeft, HeartHandshake } from 'lucide-react';
---

<Layout 
  title="Page Not Found (404) | Doctor Marriage Bureau"
  description="The requested page could not be found. Please return to the homepage or explore our verified doctor matchmaking services."
>
  <section class="min-h-[70vh] flex items-center justify-center py-20 px-4 text-center bg-[#FAFAFD]">
    <div class="max-w-md mx-auto space-y-6">
      <div class="w-20 h-20 mx-auto rounded-full bg-brand-50 border border-brand-100 flex items-center justify-center text-brand-500 shadow-inner">
        <HeartHandshake className="w-10 h-10" />
      </div>

      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-brand-100 text-brand-700">
        404 Error
      </span>

      <h1 class="text-3xl font-extrabold text-navy-950">
        Page Not Found
      </h1>

      <p class="text-sm text-navy-600 leading-relaxed">
        The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.
      </p>

      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a 
          href="/" 
          class="w-full sm:w-auto px-6 py-3 rounded-full text-xs font-bold text-white bg-brand-500 hover:bg-brand-600 shadow-md transition-all flex items-center justify-center gap-2"
        >
          <Home className="w-4 h-4" />
          <span>Return Home</span>
        </a>
        <a 
          href="/contact/" 
          class="w-full sm:w-auto px-6 py-3 rounded-full text-xs font-semibold text-navy-800 bg-white border border-navy-200 hover:bg-navy-50 transition-all flex items-center justify-center"
        >
          <span>Contact Bureau</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
