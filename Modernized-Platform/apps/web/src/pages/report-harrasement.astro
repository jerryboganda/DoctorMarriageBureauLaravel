---
import Layout from '../layouts/Layout.astro';
import HarassmentForm from '../components/forms/HarassmentForm';
import { ShieldAlert, Lock, CheckCircle2 } from 'lucide-react';
---

<Layout 
  title="Report Harassment & Incident Safeguard | Doctor Marriage Bureau"
  description="Doctor Marriage Bureau maintains zero tolerance for harassment, fake profiles, and unethical behavior. Submit confidential incident reports directly to senior management."
>
  
  <!-- Header Banner -->
  <section class="py-20 bg-gradient-to-b from-navy-950 via-navy-900 to-navy-950 text-white text-center relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-rose-600/20 via-transparent to-transparent"></div>
    
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-4">
      <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold text-rose-300 bg-rose-950/80 border border-rose-800 tracking-wider uppercase">
        Member Safety & Compliance
      </span>
      
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
        Zero Tolerance Safety & Harassment Reporting
      </h1>
      
      <p class="text-base sm:text-lg text-navy-100 max-w-2xl mx-auto text-white/90">
        We are firmly committed to safeguarding the honor, privacy, and safety of all medical candidates and their families.
      </p>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-20 bg-[#FAFAFD]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Policy Guarantees Banner -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-white border border-brand-100 shadow-sm flex items-start gap-3.5">
          <Lock className="w-6 h-6 text-brand-500 shrink-0 mt-0.5" />
          <div>
            <h4 class="text-sm font-bold text-navy-900">Strict Anonymity</h4>
            <p class="text-xs text-navy-600 mt-1">Your report is handled exclusively by executive compliance officers.</p>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-brand-100 shadow-sm flex items-start gap-3.5">
          <ShieldAlert className="w-6 h-6 text-rose-600 shrink-0 mt-0.5" />
          <div>
            <h4 class="text-sm font-bold text-navy-900">Immediate Investigation</h4>
            <p class="text-xs text-navy-600 mt-1">Reported accounts are suspended within 6 hours pending verification.</p>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-brand-100 shadow-sm flex items-start gap-3.5">
          <CheckCircle2 className="w-6 h-6 text-emerald-600 shrink-0 mt-0.5" />
          <div>
            <h4 class="text-sm font-bold text-navy-900">Legal Protection</h4>
            <p class="text-xs text-navy-600 mt-1">Strict action against fraudulent brokers and malicious conduct.</p>
          </div>
        </div>
      </div>

      <!-- Incident Report Form -->
      <HarassmentForm client:visible />

    </div>
  </section>

</Layout>
