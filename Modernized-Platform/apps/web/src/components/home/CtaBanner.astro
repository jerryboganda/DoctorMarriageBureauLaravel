---
import { HeartHandshake, ArrowRight, ShieldCheck } from 'lucide-react';
---

<section class="py-20 bg-gradient-to-r from-brand-600 via-brand-500 to-pink-600 text-white relative overflow-hidden">
  <!-- Soft Glow Accents -->
  <div class="absolute -top-12 -left-12 w-64 h-64 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>
  <div class="absolute -bottom-12 -right-12 w-64 h-64 bg-navy-900/20 rounded-full blur-2xl pointer-events-none"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 space-y-6">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/20 backdrop-blur-md text-white text-xs font-semibold">
      <ShieldCheck className="w-4 h-4 text-emerald-300" />
      <span>Confidential & Free Initial Registration</span>
    </div>

    <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white leading-tight">
      Ready to Find Your Ideal Medical Partner?
    </h2>

    <p class="max-w-2xl mx-auto text-base sm:text-lg text-white/90 leading-relaxed">
      Join thousands of Muslim healthcare professionals already registered on Doctor Marriage Bureau. Start connecting with compatible candidates today.
    </p>

    <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a 
        href="/register/" 
        class="w-full sm:w-auto px-9 py-4 rounded-full text-base font-bold text-brand-600 bg-white hover:bg-navy-50 shadow-2xl hover:shadow-white/40 transition-all duration-300 transform hover:-translate-y-0.5 flex items-center justify-center gap-2"
      >
        <HeartHandshake className="w-5 h-5 text-brand-500" />
        <span>Create Verified Profile</span>
        <ArrowRight className="w-5 h-5" />
      </a>

      <a 
        href="/login/" 
        class="w-full sm:w-auto px-9 py-4 rounded-full text-base font-semibold text-white bg-white/10 hover:bg-white/20 border border-white/30 backdrop-blur-md transition-all flex items-center justify-center"
      >
        <span>Member Login</span>
      </a>
    </div>
  </div>
</section>
