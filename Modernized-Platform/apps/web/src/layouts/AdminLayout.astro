---
import AdminSidebar from '../components/admin/AdminSidebar.astro';
import AdminTopHeader from '../components/admin/AdminTopHeader.astro';
import ToastContainer from '../components/ui/ToastContainer';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  activePath?: string;
}

const {
  title = "Admin Console — Doctor Marriage Bureau",
  description = "Complete administrative oversight, doctor verification, matchmaking governance, and payments moderation.",
  activePath = "/admin/"
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,600;0,700;0,900;1,600&display=swap" 
      rel="stylesheet" 
    />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/site-icon-192x192.png" />

    <!-- Early Admin Auth Guard -->
    <script is:inline>
      (function () {
        try {
          var token = localStorage.getItem('auth_token');
          if (!token) {
            sessionStorage.setItem('auth_error', 'Please sign in with administrator credentials.');
            window.location.replace('/login/');
            return;
          }
          var cached = sessionStorage.getItem('dmb_me');
          if (cached) {
            var u = JSON.parse(cached);
            var t = String(u.type || u.user_type || '').toLowerCase();
            if (t !== 'admin' && t !== 'staff') {
              window.location.replace('/dashboard/');
            }
          }
        } catch (e) {}
      })();
    </script>
  </head>

  <body class="bg-[#F4F6FA] text-slate-800 font-sans antialiased min-h-screen flex selection:bg-brand-500 selection:text-white">
    
    <!-- Admin Sidebar -->
    <AdminSidebar activePath={activePath} />

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0">
      <AdminTopHeader />

      <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-7xl w-full mx-auto space-y-6">
        <slot />
      </main>

      <!-- Admin Footer Note -->
      <footer class="py-4 px-6 border-t border-slate-200 text-center text-xs text-slate-500 bg-white/60">
        Doctor Marriage Bureau Administrative Console &copy; {new Date().getFullYear()} — Secure Single Stack Platform (Astro 5 + Go Backend).
      </footer>
    </div>

    <!-- Reactive Toast System -->
    <ToastContainer client:idle />

  </body>
</html>
