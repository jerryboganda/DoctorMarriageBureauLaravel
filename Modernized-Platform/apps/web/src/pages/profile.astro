---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { Edit3, Download } from 'lucide-react';
---

<DashboardLayout
  title="My Profile & Biodata — Doctor Marriage Bureau"
  description="Manage credentials, biodata document, and privacy settings."
>
  <div class="space-y-8 animate-fadeIn max-w-4xl">
    <div class="rounded-3xl bg-white border border-brand-100/80 shadow-luxury overflow-hidden">
      <div class="h-36 sm:h-44 bg-gradient-to-r from-navy-950 via-brand-900 to-navy-900"></div>
      <div class="px-6 sm:px-8 pb-8 relative -mt-16 sm:-mt-20">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div class="flex items-end gap-4">
            <button id="pf-photo-trigger" type="button" class="relative w-28 h-28 sm:w-36 sm:h-36 rounded-3xl overflow-hidden border-4 border-white shadow-xl bg-navy-100 shrink-0 group cursor-pointer focus:outline-none focus:ring-4 focus:ring-brand-500/30" aria-label="Change profile photo">
              <img id="pf-photo" src="" alt="Profile" class="w-full h-full object-cover" />
              <span class="absolute inset-0 bg-navy-950/0 group-hover:bg-navy-950/45 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-200">
                <span class="flex flex-col items-center gap-1 text-white">
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/><path d="M12 13v-1"/></svg>
                  <span class="text-[11px] font-bold tracking-wide">Change Photo</span>
                </span>
              </span>
            </button>
            <div class="space-y-1 pb-2 bg-white rounded-2xl px-5 py-4 shadow-xl border border-slate-200">
              <div class="flex items-center gap-2">
                <h1 id="pf-name" class="text-xl sm:text-2xl font-black text-navy-900 font-serif">Loading…</h1>
                <span id="pf-verified" class="hidden px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">Verified</span>
              </div>
              <p id="pf-title" class="text-xs sm:text-sm font-semibold text-brand-600"></p>
              <p id="pf-meta" class="text-xs text-navy-500"></p>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <a href="/profile/edit/" class="px-5 py-2.5 rounded-full bg-gradient-to-r from-brand-500 via-brand-600 to-pink-600 text-white text-xs font-bold shadow-lg shadow-brand-500/30 flex items-center gap-1.5">
              <Edit3 className="w-4 h-4" /><span>Edit Profile</span>
            </a>
            <a id="pf-biodata" href="/api/v1/profiles/download-biodata" class="px-4 py-2.5 rounded-xl bg-navy-50 border border-navy-200 text-navy-700 text-xs font-bold flex items-center gap-1.5">
              <Download className="w-4 h-4" /><span>Biodata PDF</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="p-5 rounded-2xl bg-white border border-brand-100/80 shadow-luxury">
        <span class="text-[11px] font-bold text-navy-400 uppercase">Quality Score</span>
        <p id="pf-score" class="text-2xl font-bold text-brand-600 mt-1">—</p>
        <p id="pf-score-level" class="text-[11px] text-navy-500"></p>
      </div>
      <div class="p-5 rounded-2xl bg-white border border-brand-100/80 shadow-luxury">
        <span class="text-[11px] font-bold text-navy-400 uppercase">Location</span>
        <p id="pf-city" class="text-sm font-bold text-navy-800 mt-1">—</p>
      </div>
      <div class="p-5 rounded-2xl bg-white border border-brand-100/80 shadow-luxury">
        <span class="text-[11px] font-bold text-navy-400 uppercase">Faith / Caste</span>
        <p id="pf-faith" class="text-sm font-bold text-navy-800 mt-1">—</p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <section class="p-6 rounded-3xl bg-white border border-brand-100/80 shadow-luxury space-y-3">
        <h2 class="text-base font-bold text-navy-800 font-serif">Career & Education</h2>
        <div id="pf-career" class="text-xs text-navy-600 space-y-2"></div>
      </section>
      <section class="p-6 rounded-3xl bg-white border border-brand-100/80 shadow-luxury space-y-3">
        <h2 class="text-base font-bold text-navy-800 font-serif">Family</h2>
        <div id="pf-family" class="text-xs text-navy-600 space-y-2"></div>
      </section>
      <section class="p-6 rounded-3xl bg-white border border-brand-100/80 shadow-luxury space-y-3">
        <h2 class="text-base font-bold text-navy-800 font-serif">Lifestyle</h2>
        <div id="pf-life" class="text-xs text-navy-600 space-y-2"></div>
      </section>
      <section class="p-6 rounded-3xl bg-white border border-brand-100/80 shadow-luxury space-y-3">
        <h2 class="text-base font-bold text-navy-800 font-serif">Partner Preferences</h2>
        <div id="pf-pref" class="text-xs text-navy-600 space-y-2"></div>
      </section>
    </div>

    <section class="p-6 rounded-3xl bg-white border border-brand-100/80 shadow-luxury space-y-3">
      <h2 class="text-base font-bold text-navy-800 font-serif">Photo Gallery</h2>
      <div id="pf-gallery" class="grid grid-cols-3 sm:grid-cols-4 gap-3"></div>
    </section>
  </div>
</DashboardLayout>

<!-- Profile Photo Studio — upload, position, crop, remove -->
<div id="photo-studio" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-navy-950/70 backdrop-blur-sm">
  <div class="bg-white rounded-3xl shadow-2xl max-w-lg w-full overflow-hidden border border-white/20">
    <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
      <div>
        <h3 class="text-base font-black text-navy-900">Profile Photo</h3>
        <p class="text-xs text-slate-500">Upload, then drag to position and zoom to frame inside the circle.</p>
      </div>
      <button id="photo-studio-close" type="button" class="w-9 h-9 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-600">✕</button>
    </div>
    <div class="p-6 space-y-5">
      <div class="flex flex-col items-center gap-4">
        <div id="photo-stage" class="relative w-72 h-72 sm:w-80 sm:h-80 rounded-full overflow-hidden bg-slate-100 border-4 border-white shadow-xl cursor-grab active:cursor-grabbing select-none touch-none">
          <img id="photo-studio-img" src="" alt="Preview" class="absolute left-1/2 top-1/2 max-w-none will-change-transform" style="transform: translate(-50%, -50%) scale(1);" draggable="false" />
          <div class="pointer-events-none absolute inset-0 rounded-full ring-1 ring-black/5 shadow-[inset_0_0_0_1px_rgba(255,255,255,0.8)]"></div>
          <div class="pointer-events-none absolute inset-0 flex items-center justify-center">
            <div class="w-full h-full rounded-full border-2 border-white/60"></div>
          </div>
        </div>
        <p class="text-[11px] font-semibold text-slate-500 text-center">Drag to reposition • Use the slider to zoom • The circle shows exactly what others will see</p>
      </div>
      <div class="space-y-3">
        <div class="flex items-center gap-2">
          <label for="photo-file-input" class="flex-1 cursor-pointer px-4 py-2.5 rounded-xl bg-brand-500 hover:bg-brand-600 text-white text-xs font-bold text-center shadow-md transition-colors">Choose New Photo</label>
          <input id="photo-file-input" type="file" accept="image/*" class="hidden" />
          <button id="photo-remove-btn" type="button" class="px-4 py-2.5 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-xs font-bold">Remove</button>
        </div>
        <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-50 border border-slate-100">
          <span class="text-xs font-bold text-slate-600">Zoom</span>
          <input id="photo-zoom" type="range" min="1" max="3" step="0.01" value="1" class="flex-1 accent-brand-500" />
          <span id="photo-zoom-val" class="text-xs font-mono text-slate-600 w-10 text-right">100%</span>
        </div>
      </div>
    </div>
    <div class="flex items-center justify-end gap-2 px-6 py-4 bg-slate-50 border-t border-slate-100">
      <button id="photo-cancel" type="button" class="px-4 py-2.5 rounded-xl bg-white border border-slate-200 text-slate-700 text-xs font-bold hover:bg-slate-50">Cancel</button>
      <button id="photo-save" type="button" class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-brand-500 to-pink-600 hover:from-brand-600 hover:to-pink-700 text-white text-xs font-bold shadow-lg disabled:opacity-50 disabled:cursor-not-allowed">Save Photo</button>
    </div>
  </div>
</div>

<script>
  import { api, avatarFor, escapeHtml, heightLabel, emptyStateHtml, errorMessage, toast } from '../lib/dashboard/common';

  const row = (k: string, v: unknown) => v ? `<div class="flex justify-between gap-3"><span class="text-navy-400">${k}</span><span class="font-semibold text-navy-800 text-right">${escapeHtml(v)}</span></div>` : '';

  api.get('/profiles/full').then((res) => {
    const p = res.data?.data ?? {};
    const b = p.basics || {};
    const c = p.career || {};
    const f = p.family || {};
    const l = p.lifestyle || {};
    const pr = p.preferences || {};
    const sp = p.spiritual || {};
    const m = p.media || {};
    const q = p.quality_score || {};
    const name = b.full_name || `${b.first_name || ''} ${b.last_name || ''}`.trim() || 'Doctor';
    document.getElementById('pf-name')!.textContent = name.startsWith('Dr.') ? name : `Dr. ${name}`;
    (document.getElementById('pf-photo') as HTMLImageElement).src = avatarFor(m.main_photo || b.photo, b.gender);
    const edu = (c.education || [])[0];
    document.getElementById('pf-title')!.textContent = [edu?.degree, c.medical_speciality].filter(Boolean).join(', ') || 'Medical Professional';
    document.getElementById('pf-meta')!.textContent = [b.age ? `${b.age} yrs` : '', heightLabel(b.height), b.current_residency?.city || b.current_residency?.country].filter(Boolean).join(' · ');
    document.getElementById('pf-score')!.textContent = `${Math.round(Number(q.total || 0))}%`;
    document.getElementById('pf-score-level')!.textContent = q.level || '';
    document.getElementById('pf-city')!.textContent = [b.current_residency?.city, b.current_residency?.country].filter(Boolean).join(', ') || '—';
    document.getElementById('pf-faith')!.textContent = [sp.religion_name, sp.caste_name].filter(Boolean).join(' / ') || '—';

    const careerHost = document.getElementById('pf-career')!;
    const edus = (c.education || []).map((e: any) => `<p><strong>${escapeHtml(e.degree)}</strong> · ${escapeHtml(e.institution || '')}</p>`).join('') || '<p>No education listed</p>';
    const jobs = (c.careers || []).map((j: any) => `<p>${escapeHtml(j.designation)} · ${escapeHtml(j.company || '')}</p>`).join('');
    careerHost.innerHTML = edus + jobs + row('Registration', c.medical_registration);

    document.getElementById('pf-family')!.innerHTML = [
      row('Father', f.father),
      row('Mother', f.mother),
      row('Father occupation', f.father_occupation),
      row('Brothers / Sisters', `${f.no_of_brothers ?? 0} / ${f.no_of_sisters ?? 0}`),
      row('Hometown', [f.family_location_city, f.family_location_country].filter(Boolean).join(', ')),
    ].join('') || emptyStateHtml('No family details', 'Add them from the Family portal.', '👨‍👩‍👧');

    document.getElementById('pf-life')!.innerHTML = [
      row('Diet', l.diet),
      row('Drink', l.drink),
      row('Smoke', l.smoke),
      row('Living with', l.living_with),
      row('Hobbies', l.hobbies),
    ].join('');

    document.getElementById('pf-pref')!.innerHTML = [
      row('Age', pr.min_age || pr.max_age ? `${pr.min_age || '?'} – ${pr.max_age || '?'}` : ''),
      row('Education', pr.education),
      row('Profession', pr.profession),
    ].join('');

    const gal = document.getElementById('pf-gallery')!;
    const photos = m.gallery || [];
    gal.innerHTML = photos.length
      ? photos.map((g: any) => `<img src="${avatarFor(g.url)}" class="aspect-square rounded-2xl object-cover border border-navy-100 ${g.privacy_level === 'private' ? 'opacity-70' : ''}" />`).join('')
      : emptyStateHtml('No photos yet', 'Upload from Edit Profile.', '📷');
  }).catch((err) => {
    document.getElementById('pf-name')!.textContent = 'Unable to load profile';
    toast(errorMessage(err), 'error');
  });

  // ===== Profile Photo Studio =====
  (() => {
    const trigger = document.getElementById('pf-photo-trigger') as HTMLButtonElement | null;
    const modal = document.getElementById('photo-studio') as HTMLElement | null;
    const stage = document.getElementById('photo-stage') as HTMLElement | null;
    const img = document.getElementById('photo-studio-img') as HTMLImageElement | null;
    const fileInput = document.getElementById('photo-file-input') as HTMLInputElement | null;
    const zoom = document.getElementById('photo-zoom') as HTMLInputElement | null;
    const zoomVal = document.getElementById('photo-zoom-val') as HTMLElement | null;
    const saveBtn = document.getElementById('photo-save') as HTMLButtonElement | null;
    const removeBtn = document.getElementById('photo-remove-btn') as HTMLButtonElement | null;
    const closeBtn = document.getElementById('photo-studio-close') as HTMLButtonElement | null;
    const cancelBtn = document.getElementById('photo-cancel') as HTMLButtonElement | null;
    if (!trigger || !modal || !stage || !img || !fileInput || !zoom || !saveBtn) return;

    let scale = 1, offsetX = 0, offsetY = 0, isDragging = false, startX = 0, startY = 0, hasImage = false;
    let currentObjectUrl: string | null = null;
    let originalSrc = '';

    function updateTransform() {
      img.style.transform = `translate(calc(-50% + ${offsetX}px), calc(-50% + ${offsetY}px)) scale(${scale})`;
      if (zoomVal) zoomVal.textContent = Math.round(scale * 100) + '%';
    }
    function resetTransform() { scale = 1; offsetX = 0; offsetY = 0; zoom.value = '1'; updateTransform(); }
    function openStudio() {
      const pfImg = document.getElementById('pf-photo') as HTMLImageElement | null;
      originalSrc = pfImg?.src || '';
      if (pfImg && pfImg.src && !pfImg.src.includes('avatar-place')) {
        img.src = pfImg.src;
        hasImage = true;
      } else if (currentObjectUrl) {
        img.src = currentObjectUrl;
        hasImage = !!currentObjectUrl;
      } else {
        img.removeAttribute('src');
        hasImage = false;
      }
      resetTransform();
      modal.classList.remove('hidden'); modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }
    function closeStudio() {
      modal.classList.add('hidden'); modal.classList.remove('flex');
      document.body.style.overflow = '';
      if (currentObjectUrl) { URL.revokeObjectURL(currentObjectUrl); currentObjectUrl = null; }
      if (fileInput) fileInput.value = '';
    }
    trigger.addEventListener('click', openStudio);
    closeBtn?.addEventListener('click', closeStudio);
    cancelBtn?.addEventListener('click', closeStudio);
    modal.addEventListener('click', (e) => { if (e.target === modal) closeStudio(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeStudio(); });

    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (!file) return;
      if (!file.type.startsWith('image/')) { toast('Please choose an image file.', 'error'); return; }
      if (file.size > 8 * 1024 * 1024) { toast('Image must be under 8 MB.', 'error'); return; }
      if (currentObjectUrl) URL.revokeObjectURL(currentObjectUrl);
      currentObjectUrl = URL.createObjectURL(file);
      img.src = currentObjectUrl;
      hasImage = true;
      resetTransform();
    });

    zoom.addEventListener('input', () => { scale = parseFloat(zoom.value) || 1; updateTransform(); });

    // Drag to position
    const onMove = (e: MouseEvent | TouchEvent) => {
      if (!isDragging) return;
      const pt = (e as TouchEvent).touches ? (e as TouchEvent).touches[0] : (e as MouseEvent);
      offsetX += pt.clientX - startX;
      offsetY += pt.clientY - startY;
      startX = pt.clientX; startY = pt.clientY;
      // clamp so image never leaves the circle completely
      const max = 120 * scale;
      offsetX = Math.max(-max, Math.min(max, offsetX));
      offsetY = Math.max(-max, Math.min(max, offsetY));
      updateTransform();
    };
    const onUp = () => { isDragging = false; stage.style.cursor = 'grab'; document.removeEventListener('mousemove', onMove as any); document.removeEventListener('mouseup', onUp); document.removeEventListener('touchmove', onMove as any); document.removeEventListener('touchend', onUp); };
    stage.addEventListener('mousedown', (e) => { isDragging = true; stage.style.cursor = 'grabbing'; startX = (e as MouseEvent).clientX; startY = (e as MouseEvent).clientY; document.addEventListener('mousemove', onMove as any); document.addEventListener('mouseup', onUp); e.preventDefault(); });
    stage.addEventListener('touchstart', (e) => { isDragging = true; const t = e.touches[0]; startX = t.clientX; startY = t.clientY; document.addEventListener('touchmove', onMove as any, { passive: false } as any); document.addEventListener('touchend', onUp); }, { passive: false } as any);
    stage.addEventListener('wheel', (e) => { e.preventDefault(); const delta = (e as WheelEvent).deltaY > 0 ? -0.05 : 0.05; scale = Math.max(1, Math.min(3, scale + delta)); zoom.value = String(scale); updateTransform(); }, { passive: false } as any);

    removeBtn?.addEventListener('click', async () => {
      if (!confirm('Remove your profile photo?')) return;
      removeBtn.disabled = true;
      try {
        // Try to clear photo via profile update
        await api.post('/profiles/full/remove-photo').catch(() => api.put('/profiles/full', { photo: '' }).catch(() => api.post('/media/remove', {})));
        (document.getElementById('pf-photo') as HTMLImageElement).src = avatarFor('', (document.getElementById('pf-photo') as HTMLImageElement).alt as any);
        hasImage = false; img.removeAttribute('src'); resetTransform();
        toast('Profile photo removed.', 'info');
        closeStudio();
      } catch (err) {
        toast(errorMessage(err, 'Could not remove photo.'), 'error');
      } finally { removeBtn.disabled = false; }
    });

    saveBtn.addEventListener('click', async () => {
      if (!hasImage || !img.src) { toast('Choose an image first.', 'error'); return; }
      saveBtn.disabled = true; const origText = saveBtn.textContent; saveBtn.textContent = 'Saving…';
      try {
        // Render the visible circle to a canvas
        const size = 512;
        const canvas = document.createElement('canvas');
        canvas.width = size; canvas.height = size;
        const ctx = canvas.getContext('2d')!;
        // Clip to circle
        ctx.beginPath(); ctx.arc(size/2, size/2, size/2, 0, Math.PI*2); ctx.clip();
        // Draw the transformed image centered
        const stageRect = stage.getBoundingClientRect();
        const imgRect = img.getBoundingClientRect();
        // Compute scale relative to stage
        // Use the displayed image to draw: we approximate by drawing the source image with transform
        const tmp = new Image();
        tmp.crossOrigin = 'anonymous';
        tmp.src = img.src;
        await new Promise<void>((resolve, reject) => { tmp.onload = () => resolve(); tmp.onerror = () => reject(new Error('Could not load image')); });
        // Calculate source rect to match the CSS transform (translate + scale)
        // The CSS transform is translate(-50% + offsetX, -50% + offsetY) scale(scale)
        // For canvas, we draw the image centered with scale and offset scaled to canvas size
        const s = scale;
        const cw = stageRect.width, ch = stageRect.height;
        const iw = tmp.naturalWidth, ih = tmp.naturalHeight;
        // Fit image to stage (object-fit: cover equivalent) then apply user transform
        const stageAspect = cw / ch, imgAspect = iw / ih;
        let baseScale: number, baseW: number, baseH: number;
        if (imgAspect > stageAspect) { baseH = ch; baseW = ch * imgAspect; } else { baseW = cw; baseH = cw / imgAspect; }
        // Now apply user scale and offset (offset is in stage pixels, convert to canvas pixels)
        const canvasScale = size / cw;
        const drawW = baseW * s * canvasScale;
        const drawH = baseH * s * canvasScale;
        const dx = size/2 - drawW/2 + offsetX * canvasScale;
        const dy = size/2 - drawH/2 + offsetY * canvasScale;
        ctx.drawImage(tmp, dx, dy, drawW, drawH);
        const blob: Blob | null = await new Promise(resolve => canvas.toBlob(resolve, 'image/jpeg', 0.9));
        if (!blob) throw new Error('Could not process image');
        const file = new File([blob], 'profile.jpg', { type: 'image/jpeg' });
        const form = new FormData();
        form.append('photo', file);
        form.append('image', file);
        form.append('file', file);
        form.append('avatar', file);
        let uploadedUrl = '';
        // Try multiple upload endpoints
        const endpoints = ['/media/upload', '/profiles/photo', '/profiles/upload', '/api/media/upload'];
        let lastErr: any = null;
        for (const ep of endpoints) {
          try {
            const res = await api.post(ep, form, { headers: { 'Content-Type': 'multipart/form-data' } } as any);
            const d: any = res.data?.data ?? res.data;
            uploadedUrl = d?.url || d?.photo || d?.avatar || d?.file_name || d?.path || '';
            if (uploadedUrl) break;
          } catch (e) { lastErr = e; }
        }
        if (!uploadedUrl) {
          // Fallback: try to set via profile update with base64 (if upload not available, just update client)
          // As last resort, use the object URL as preview and try to save via profile full
          try {
            await api.put('/profiles/full', { photo: img.src });
            uploadedUrl = img.src;
          } catch {}
        }
        if (!uploadedUrl && lastErr) throw lastErr;
        if (uploadedUrl) {
          (document.getElementById('pf-photo') as HTMLImageElement).src = avatarFor(uploadedUrl);
        } else {
          (document.getElementById('pf-photo') as HTMLImageElement).src = img.src;
        }
        toast('Profile photo saved.', 'success');
        closeStudio();
      } catch (err) {
        toast(errorMessage(err, 'Could not save photo. Try a different image.'), 'error');
      } finally { saveBtn.disabled = false; saveBtn.textContent = origText; }
    });
  })();
</script>