---
import PublicLayout from '../layouts/PublicLayout.astro';
import { 
  ShieldCheck, 
  Lock, 
  Mail, 
  ArrowRight, 
  CheckCircle2
} from 'lucide-react';
---

<PublicLayout 
  title="Doctor Login — Doctor Marriage Bureau"
  description="Secure halal login for registered medical doctors and healthcare professionals."
>
  <div class="min-h-[85vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-slate-50 via-white to-pink-50/20">
    <div class="w-full max-w-md space-y-8 animate-fadeIn">
      
      <!-- Card Container -->
      <div class="bg-white rounded-3xl p-8 sm:p-10 border border-brand-100/80 shadow-luxury space-y-6">
        
        <!-- Header -->
        <div class="text-center space-y-2">
          <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-brand-50 border border-brand-100 text-brand-600 text-xs font-bold">
            <ShieldCheck className="w-4 h-4" />
            <span>Doctor Portal Access</span>
          </div>

          <h1 class="text-2xl sm:text-3xl font-extrabold text-navy-900 font-serif">
            Welcome <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-500 to-pink-500">Back</span>
          </h1>

          <p class="text-xs text-navy-500">
            Sign in to access your proposals, messages, and verified medical matches
          </p>
        </div>

        <!-- Error Banner -->
        <div id="login-error" class="hidden rounded-2xl bg-brand-50 border border-brand-200 px-4 py-3 text-xs font-semibold text-brand-700"></div>

        <!-- Login Form -->
        <form id="login-form" class="space-y-4">
          
          <!-- Email / Phone Input -->
          <div class="space-y-1.5">
            <label class="text-xs font-bold text-navy-700">Email Address or Mobile Number</label>
            <div class="relative">
              <input 
                type="text" 
                id="login-identity"
                name="email_or_phone"
                required 
                autocomplete="username"
                placeholder="doctor@hospital.org or 03001234567"
                class="w-full pl-10 pr-4 py-3 rounded-2xl text-xs bg-slate-50 border border-slate-200 focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 text-navy-900 transition-all outline-none"
              />
              <Mail className="w-4 h-4 text-navy-400 absolute left-3.5 top-1/2 -translate-y-1/2" />
            </div>
          </div>

          <!-- Password Input -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <label class="text-xs font-bold text-navy-700">Password</label>
              <a href="/forgot-password/" class="text-[11px] font-bold text-brand-600 hover:text-brand-700">Forgot?</a>
            </div>
            <div class="relative">
              <input 
                type="password" 
                id="login-password"
                name="password"
                required 
                autocomplete="current-password"
                placeholder="••••••••••••"
                class="w-full pl-10 pr-4 py-3 rounded-2xl text-xs bg-slate-50 border border-slate-200 focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 text-navy-900 transition-all outline-none"
              />
              <Lock className="w-4 h-4 text-navy-400 absolute left-3.5 top-1/2 -translate-y-1/2" />
            </div>
          </div>

          <!-- Submit Button -->
          <button 
            type="submit"
            id="login-submit"
            class="w-full py-3.5 px-6 rounded-2xl bg-gradient-to-r from-brand-500 to-brand-600 hover:from-brand-600 hover:to-brand-700 text-white text-xs font-bold shadow-lg shadow-brand-500/25 hover:shadow-xl hover:shadow-brand-500/35 transition-all transform hover:-translate-y-0.5 flex items-center justify-center gap-2 disabled:opacity-60 disabled:cursor-not-allowed disabled:transform-none"
          >
            <span>Sign In to Doctor Portal</span>
            <ArrowRight className="w-4 h-4" />
          </button>

        </form>

        <!-- Divider -->
        <div class="relative flex items-center justify-center">
          <div class="border-t border-slate-200 w-full"></div>
          <span class="bg-white px-3 text-[11px] text-navy-400 uppercase font-semibold">or</span>
        </div>

        <!-- Create Account Link -->
        <div class="text-center pt-2">
          <p class="text-xs text-navy-600">
            Don't have a doctor profile yet? 
            <a href="/register/" class="font-bold text-brand-600 hover:text-brand-700 underline ml-1">
              Register Free
            </a>
          </p>
        </div>

      </div>

      <!-- Trust Badges -->
      <div class="flex items-center justify-center gap-6 text-xs text-navy-500">
        <div class="flex items-center gap-1.5">
          <CheckCircle2 className="w-4 h-4 text-emerald-500" />
          <span>100% Confidential</span>
        </div>
        <div class="flex items-center gap-1.5">
          <ShieldCheck className="w-4 h-4 text-emerald-500" />
          <span>PMDC Verified</span>
        </div>
      </div>

    </div>
  </div>

  <script>
    import { api, errorMessage } from '../lib/dashboard/common';

    const form = document.getElementById('login-form') as HTMLFormElement;
    const errBox = document.getElementById('login-error') as HTMLElement;
    const submitBtn = document.getElementById('login-submit') as HTMLButtonElement;

    // Show messages passed from guards/interceptors
    const authError = sessionStorage.getItem('auth_error');
    if (authError) {
      errBox.textContent = authError;
      errBox.classList.remove('hidden');
      sessionStorage.removeItem('auth_error');
    }

    // Already signed in? Route based on user role
    if (localStorage.getItem('auth_token')) {
      const cached = sessionStorage.getItem('dmb_me');
      if (cached) {
        try {
          const u = JSON.parse(cached);
          const t = String(u?.type || u?.user_type || '').toLowerCase();
          if (t === 'admin' || t === 'staff') {
            window.location.replace('/admin/');
          } else {
            window.location.replace('/dashboard/');
          }
        } catch {
          window.location.replace('/dashboard/');
        }
      } else {
        api.get('/auth/me').then((res) => {
          const u = res.data?.data;
          if (u) sessionStorage.setItem('dmb_me', JSON.stringify(u));
          const t = String(u?.type || u?.user_type || '').toLowerCase();
          if (t === 'admin' || t === 'staff') {
            window.location.replace('/admin/');
          } else {
            window.location.replace('/dashboard/');
          }
        }).catch(() => {
          window.location.replace('/dashboard/');
        });
      }
    }

    form?.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      errBox.classList.add('hidden');
      submitBtn.disabled = true;

      const identity = (document.getElementById('login-identity') as HTMLInputElement).value.trim();
      const password = (document.getElementById('login-password') as HTMLInputElement).value;

      try {
        const res = await api.post('/auth/signin', { email_or_phone: identity, password });
        const data = res.data?.data;
        const token = data?.token;
        if (!token) throw new Error(res.data?.message || 'Sign in failed. Please try again.');
        localStorage.setItem('auth_token', token);
        if (data?.user) sessionStorage.setItem('dmb_me', JSON.stringify(data.user));

        const userType = String(data?.user?.type || data?.user?.user_type || '').toLowerCase();
        if (userType === 'admin' || userType === 'staff') {
          window.location.href = '/admin/';
        } else {
          window.location.href = '/dashboard/';
        }
      } catch (err) {
        errBox.textContent = errorMessage(err, 'Invalid credentials. Please check your email/phone and password.');
        errBox.classList.remove('hidden');
        submitBtn.disabled = false;
      }
    });
  </script>
</PublicLayout>
