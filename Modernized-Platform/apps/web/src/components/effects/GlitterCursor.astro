---
// High-performance Decent Colored Glittering Mouse Cursor & Follower
---

<div id="dmb-glitter-cursor-container" class="pointer-events-none fixed inset-0 z-[999999] overflow-hidden select-none" aria-hidden="true">
  <!-- Interactive Hover Trailing Ring -->
  <div 
    id="dmb-cursor-ring" 
    class="fixed top-0 left-0 w-8 h-8 rounded-full border border-pink-400/60 bg-pink-500/10 shadow-[0_0_15px_rgba(255,32,110,0.35)] backdrop-blur-[0.5px] transition-[width,height,background-color,border-color,transform] duration-200 ease-out will-change-transform opacity-0 pointer-events-none -translate-x-1/2 -translate-y-1/2"
  ></div>

  <!-- Colored Glowing Center Cursor Core -->
  <div 
    id="dmb-cursor-dot" 
    class="fixed top-0 left-0 w-3 h-3 rounded-full bg-gradient-to-tr from-pink-600 via-rose-500 to-amber-300 shadow-[0_0_12px_rgba(255,32,110,0.8),0_0_4px_rgba(255,215,0,0.9)] will-change-transform opacity-0 pointer-events-none -translate-x-1/2 -translate-y-1/2 ring-1 ring-white/70"
  ></div>

  <!-- High FPS Canvas for Glittering Trail & Sparkle Stars -->
  <canvas 
    id="dmb-glitter-canvas" 
    class="fixed inset-0 w-full h-full pointer-events-none"
  ></canvas>
</div>

<style is:global>
  /* Show smooth custom pointer feel on desktop devices with fine pointer */
  @media (pointer: fine) {
    /* Custom cursor dot hover animation styles */
    .dmb-cursor-hover #dmb-cursor-ring {
      width: 48px;
      height: 48px;
      background-color: rgba(255, 32, 110, 0.18);
      border-color: rgba(255, 32, 110, 0.9);
      box-shadow: 0 0 22px rgba(255, 32, 110, 0.5), 0 0 10px rgba(255, 215, 0, 0.4);
    }
    
    .dmb-cursor-hover #dmb-cursor-dot {
      transform: translate(-50%, -50%) scale(1.35);
      box-shadow: 0 0 16px rgba(255, 32, 110, 1), 0 0 8px rgba(255, 215, 0, 1);
    }

    .dmb-cursor-active #dmb-cursor-ring {
      width: 26px;
      height: 26px;
      background-color: rgba(255, 32, 110, 0.35);
    }
  }

  @media (pointer: coarse) {
    #dmb-glitter-cursor-container {
      display: none !important;
    }
  }
</style>

<script>
  function initGlitterCursor() {
    // Only activate on devices with fine pointer (mouse/trackpad)
    if (window.matchMedia && !window.matchMedia('(pointer: fine)').matches) {
      return;
    }

    const container = document.getElementById('dmb-glitter-cursor-container');
    const ring = document.getElementById('dmb-cursor-ring');
    const dot = document.getElementById('dmb-cursor-dot');
    const canvas = document.getElementById('dmb-glitter-canvas') as HTMLCanvasElement | null;

    if (!container || !ring || !dot || !canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    window.addEventListener('resize', () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    }, { passive: true });

    // State
    let mouseX = -100;
    let mouseY = -100;
    let ringX = -100;
    let ringY = -100;
    let isVisible = false;
    let isHovering = false;
    let lastMoveTime = performance.now();
    let isLoopRunning = false;

    // Palette of vibrant, decent glittering diamond & medical-gold colors
    const glitterColors = [
      '#FF206E', // Vivid Rose / Brand Magenta
      '#FF6584', // Soft Coral Pink
      '#FFD700', // Royal Gold
      '#FFE57F', // Champagne Glitter
      '#00F2FE', // Ice Diamond Cyan
      '#C084FC', // Lavender Sparkle
      '#FFFFFF', // Pure Starlight White
    ];

    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      size: number;
      color: string;
      alpha: number;
      decay: number;
      rotation: number;
      rotSpeed: number;
      shape: 'star' | 'circle' | 'diamond';
      sparkleFrequency: number;
      age: number;
    }

    const particles: Particle[] = [];

    // Helper: Draw 4-point glittering star
    function drawStar(c: CanvasRenderingContext2D, cx: number, cy: number, spikes: number, outerRadius: number, innerRadius: number, color: string, alpha: number, rotation: number) {
      c.save();
      c.translate(cx, cy);
      c.rotate(rotation);
      c.beginPath();
      
      let rot = (Math.PI / 2) * 3;
      let step = Math.PI / spikes;

      c.moveTo(0, -outerRadius);
      for (let i = 0; i < spikes; i++) {
        let x = Math.cos(rot) * outerRadius;
        let y = Math.sin(rot) * outerRadius;
        c.lineTo(x, y);
        rot += step;

        x = Math.cos(rot) * innerRadius;
        y = Math.sin(rot) * innerRadius;
        c.lineTo(x, y);
        rot += step;
      }
      c.lineTo(0, -outerRadius);
      c.closePath();

      c.fillStyle = color;
      c.globalAlpha = alpha;
      c.shadowColor = color;
      c.shadowBlur = outerRadius * 2;
      c.fill();
      c.restore();
    }

    // Helper: Spawn glitter particles
    function addGlitter(x: number, y: number, count = 2, speedMultiplier = 1) {
      for (let i = 0; i < count; i++) {
        if (particles.length > 180) particles.shift(); // keep memory bounded

        const angle = Math.random() * Math.PI * 2;
        const speed = (0.6 + Math.random() * 2.2) * speedMultiplier;
        const color = glitterColors[Math.floor(Math.random() * glitterColors.length)];
        const shapeType = Math.random() > 0.4 ? 'star' : (Math.random() > 0.5 ? 'diamond' : 'circle');

        particles.push({
          x: x + (Math.random() - 0.5) * 8,
          y: y + (Math.random() - 0.5) * 8,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed + (Math.random() * 0.4 - 0.1), // slight float
          size: 2 + Math.random() * 4.5,
          color,
          alpha: 0.95,
          decay: 0.016 + Math.random() * 0.025,
          rotation: Math.random() * Math.PI * 2,
          rotSpeed: (Math.random() - 0.5) * 0.15,
          shape: shapeType,
          sparkleFrequency: 0.15 + Math.random() * 0.3,
          age: 0,
        });
      }

      startLoop();
    }

    // Main Animation Loop
    function animate() {
      // Clear canvas
      ctx.clearRect(0, 0, width, height);

      // Smooth trailing ring lerp (linear interpolation)
      const lerpFactor = 0.22;
      ringX += (mouseX - ringX) * lerpFactor;
      ringY += (mouseY - ringY) * lerpFactor;

      if (isVisible) {
        dot.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0)`;
        ring.style.transform = `translate3d(${ringX}px, ${ringY}px, 0)`;
      }

      // Update and draw particles
      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.age += 1;
        p.x += p.vx;
        p.y += p.vy;
        p.vy += 0.015; // gentle gravity
        p.vx *= 0.98;
        p.vy *= 0.98;
        p.rotation += p.rotSpeed;
        p.alpha -= p.decay;

        if (p.alpha <= 0 || p.x < 0 || p.x > width || p.y < 0 || p.y > height) {
          particles.splice(i, 1);
          continue;
        }

        // Sparkling twinkle intensity modulation
        const sparkleFactor = (Math.sin(p.age * p.sparkleFrequency) + 1) * 0.3 + 0.4;
        const currentAlpha = Math.max(0, Math.min(1, p.alpha * sparkleFactor));

        if (p.shape === 'star') {
          drawStar(ctx, p.x, p.y, 4, p.size, p.size * 0.28, p.color, currentAlpha, p.rotation);
        } else if (p.shape === 'diamond') {
          drawStar(ctx, p.x, p.y, 4, p.size * 0.8, p.size * 0.35, p.color, currentAlpha, p.rotation);
        } else {
          // Circular shimmering orb
          ctx.save();
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size * 0.5, 0, Math.PI * 2);
          ctx.fillStyle = p.color;
          ctx.globalAlpha = currentAlpha;
          ctx.shadowColor = p.color;
          ctx.shadowBlur = p.size * 2;
          ctx.fill();
          ctx.restore();
        }
      }

      // If particles still exist or cursor is moving, continue loop
      const isStillMoving = (Math.abs(mouseX - ringX) > 0.2 || Math.abs(mouseY - ringY) > 0.2);
      if (particles.length > 0 || isStillMoving || (performance.now() - lastMoveTime < 1000)) {
        requestAnimationFrame(animate);
      } else {
        isLoopRunning = false;
      }
    }

    function startLoop() {
      if (!isLoopRunning) {
        isLoopRunning = true;
        requestAnimationFrame(animate);
      }
    }

    // Mouse Move Event Listener
    window.addEventListener('mousemove', (e) => {
      const prevX = mouseX;
      const prevY = mouseY;
      mouseX = e.clientX;
      mouseY = e.clientY;
      lastMoveTime = performance.now();

      if (!isVisible) {
        isVisible = true;
        ringX = mouseX;
        ringY = mouseY;
        dot.style.opacity = '1';
        ring.style.opacity = '1';
      }

      // Calculate movement delta to spawn proportional sparkles
      const dist = Math.hypot(mouseX - prevX, mouseY - prevY);
      if (dist > 3) {
        // Spawn glittering particles based on movement velocity
        const count = dist > 40 ? 3 : (dist > 15 ? 2 : 1);
        addGlitter(mouseX, mouseY, count, 1);
      }

      startLoop();
    }, { passive: true });

    // Mouse Leave / Enter window listeners
    document.addEventListener('mouseleave', () => {
      isVisible = false;
      dot.style.opacity = '0';
      ring.style.opacity = '0';
    });

    document.addEventListener('mouseenter', () => {
      isVisible = true;
      dot.style.opacity = '1';
      ring.style.opacity = '1';
    });

    // Mouse Click Sparkle Burst
    window.addEventListener('mousedown', (e) => {
      document.body.classList.add('dmb-cursor-active');
      // Burst of 12-16 sparkling glittering particles
      addGlitter(e.clientX, e.clientY, 14, 2.5);
    });

    window.addEventListener('mouseup', () => {
      document.body.classList.remove('dmb-cursor-active');
    });

    // Detect clickable hover elements
    const updateHoverState = (e: MouseEvent) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      const interactive = target.closest('a, button, input, select, textarea, [role="button"], .cursor-pointer, [data-interactive]');
      if (interactive) {
        if (!isHovering) {
          isHovering = true;
          document.body.classList.add('dmb-cursor-hover');
          // Add a soft sparkle on hover trigger
          addGlitter(mouseX, mouseY, 4, 1.2);
        }
      } else {
        if (isHovering) {
          isHovering = false;
          document.body.classList.remove('dmb-cursor-hover');
        }
      }
    };

    window.addEventListener('mouseover', updateHoverState, { passive: true });
  }

  // Initialize on load and Astro view transitions
  if (typeof document !== 'undefined') {
    initGlitterCursor();
    document.addEventListener('astro:page-load', initGlitterCursor);
  }
</script>
