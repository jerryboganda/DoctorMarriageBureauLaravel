---
import { Globe2, ShieldCheck, Heart, Award } from 'lucide-react';
---

<section class="py-20 bg-navy-950 text-white relative overflow-hidden">
  <!-- Glowing Background Orbs -->
  <div class="absolute -top-24 -left-24 w-96 h-96 bg-brand-500/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-navy-500/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-3.5 py-1.5 rounded-full text-xs font-semibold text-brand-300 bg-white/10 border border-white/10 tracking-wider uppercase mb-3">
        Proven Track Record
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Our Success in <span class="bg-gradient-to-r from-brand-400 to-pink-300 bg-clip-text text-transparent">Numbers</span>
      </h2>
      <p class="mt-4 text-sm sm:text-base text-navy-200 leading-relaxed">
        Building lifelong marriages between healthcare professionals with trust, Islamic values, and unmatched integrity.
      </p>
    </div>

    <!-- Stats Grid (populated live from /api/v1/public/stats) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      <div class="rounded-3xl p-8 bg-white/5 backdrop-blur-md border border-white/10 hover:border-brand-500/40 transition-all duration-300 transform hover:-translate-y-1 text-center flex flex-col items-center">
        <div class="w-14 h-14 rounded-2xl bg-brand-500/20 text-brand-400 flex items-center justify-center mb-5 border border-brand-500/30">
          <Award className="w-7 h-7" />
        </div>
        <div id="metric-verifiedDoctors" class="text-4xl sm:text-5xl font-extrabold text-white mb-2 tracking-tight">—</div>
        <div class="text-base font-bold text-brand-300 mb-2">Verified Doctors</div>
        <p class="text-xs text-white/70 leading-relaxed">PMDC/MBCP-verified medical professionals on the platform.</p>
      </div>

      <div class="rounded-3xl p-8 bg-white/5 backdrop-blur-md border border-white/10 hover:border-brand-500/40 transition-all duration-300 transform hover:-translate-y-1 text-center flex flex-col items-center">
        <div class="w-14 h-14 rounded-2xl bg-brand-500/20 text-brand-400 flex items-center justify-center mb-5 border border-brand-500/30">
          <Globe2 className="w-7 h-7" />
        </div>
        <div id="metric-countriesServed" class="text-4xl sm:text-5xl font-extrabold text-white mb-2 tracking-tight">—</div>
        <div class="text-base font-bold text-brand-300 mb-2">Countries Served</div>
        <p class="text-xs text-white/70 leading-relaxed">Doctor candidates and families connected across the globe.</p>
      </div>

      <div class="rounded-3xl p-8 bg-white/5 backdrop-blur-md border border-white/10 hover:border-brand-500/40 transition-all duration-300 transform hover:-translate-y-1 text-center flex flex-col items-center">
        <div class="w-14 h-14 rounded-2xl bg-brand-500/20 text-brand-400 flex items-center justify-center mb-5 border border-brand-500/30">
          <ShieldCheck className="w-7 h-7" />
        </div>
        <div id="metric-totalMembers" class="text-4xl sm:text-5xl font-extrabold text-white mb-2 tracking-tight">—</div>
        <div class="text-base font-bold text-brand-300 mb-2">Registered Members</div>
        <p class="text-xs text-white/70 leading-relaxed">Healthcare professionals and families in our confidential network.</p>
      </div>

      <div class="rounded-3xl p-8 bg-white/5 backdrop-blur-md border border-white/10 hover:border-brand-500/40 transition-all duration-300 transform hover:-translate-y-1 text-center flex flex-col items-center">
        <div class="w-14 h-14 rounded-2xl bg-brand-500/20 text-brand-400 flex items-center justify-center mb-5 border border-brand-500/30">
          <Heart className="w-7 h-7" />
        </div>
        <div id="metric-successfulUnions" class="text-4xl sm:text-5xl font-extrabold text-white mb-2 tracking-tight">—</div>
        <div class="text-base font-bold text-brand-300 mb-2">Successful Unions</div>
        <p class="text-xs text-white/70 leading-relaxed">Approved, celebrated doctor marriages through the bureau.</p>
      </div>
    </div>

  </div>
</section>

<script>
  (function () {
    const API = (import.meta.env.PUBLIC_API_URL || 'http://127.0.0.1:8080/api/v1').replace(/\/$/, '');
    const fmt = function (n) {
      return Number(n || 0).toLocaleString('en-US');
    };
    const ids = ['verifiedDoctors', 'countriesServed', 'totalMembers', 'successfulUnions'];
    (async function () {
      try {
        const res = await fetch(API + '/public/stats');
        const env = await res.json();
        const s = env?.data || {};
        ids.forEach(function (k) {
          const el = document.getElementById('metric-' + k);
          if (el && s[k] !== undefined) el.textContent = fmt(s[k]);
        });
      } catch (e) {
        /* leave placeholders on failure */
      }
    })();
  })();
</script>
