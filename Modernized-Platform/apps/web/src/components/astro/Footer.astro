---
import { Phone, Mail, MapPin, Facebook, Instagram, ShieldCheck, Heart, Send } from 'lucide-react';
---

<footer class="bg-[#1E1B38] text-white pt-16 pb-8 border-t border-[#3a1d2c] relative overflow-hidden">
  <!-- Subtle luxury glow effect in backdrop -->
  <div class="absolute top-0 left-1/4 w-96 h-96 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      
      <!-- Col 1: Bureau Intro -->
      <div class="space-y-4">
        <img 
          src="/images/logo.png" 
          alt="Doctor Marriage Bureau" 
          class="h-10 w-auto brightness-0 invert opacity-95 object-contain"
          width="160"
          height="40"
          loading="lazy"
        />
        <p class="text-slate-300 text-sm leading-relaxed">
          Pakistan's premier and trusted matrimonial platform exclusively designed for Muslim doctors and healthcare professionals. Offering 100% verified halal matchmaking with strict confidentiality.
        </p>
        <div class="flex items-center gap-3 pt-2">
          <a href="https://www.facebook.com/share/1D1xRXZXjS/" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full bg-white/10 hover:bg-primary text-white flex items-center justify-center transition-colors" aria-label="Facebook">
            <Facebook className="w-4 h-4" />
          </a>
          <a href="https://www.instagram.com/doctorsmarriagebureauofficial?igsh=MTh0d2k1bjVtM2t1MA==" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full bg-white/10 hover:bg-primary text-white flex items-center justify-center transition-colors" aria-label="Instagram">
            <Instagram className="w-4 h-4" />
          </a>
          <a href="https://www.tiktok.com/@doctorsmariagebuearu?_r=1&_t=ZS-91kz5zdzjuc" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full bg-white/10 hover:bg-primary text-white flex items-center justify-center transition-colors font-bold text-xs" aria-label="TikTok">
            TT
          </a>
        </div>
      </div>

      <!-- Col 2: Quick Links -->
      <div>
        <h3 class="text-base font-bold text-white mb-4 tracking-wide flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-primary"></span>
          Quick Links
        </h3>
        <ul class="space-y-2.5 text-sm text-slate-300">
          <li>
            <a href="/" class="hover:text-primary transition-colors flex items-center gap-1.5">
              <span>Home</span>
            </a>
          </li>
          <li>
            <a href="/about" class="hover:text-primary transition-colors flex items-center gap-1.5">
              <span>About Us</span>
            </a>
          </li>
          <li>
            <a href="/packages" class="hover:text-primary transition-colors flex items-center gap-1.5">
              <span>Membership Packages</span>
            </a>
          </li>
          <li>
            <a href="/contact" class="hover:text-primary transition-colors flex items-center gap-1.5">
              <span>Contact Us</span>
            </a>
          </li>
          <li>
            <a href="/report-harrasement" class="hover:text-primary transition-colors flex items-center gap-1.5 text-pink-300 font-medium">
              <ShieldCheck className="w-4 h-4" />
              <span>Report Harassment</span>
            </a>
          </li>
          <li>
            <a href="/privacy-policy" class="hover:text-primary transition-colors flex items-center gap-1.5">
              <span>Privacy Policy</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Direct Contact Information -->
      <div>
        <h3 class="text-base font-bold text-white mb-4 tracking-wide flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-primary"></span>
          Get In Touch
        </h3>
        <ul class="space-y-3.5 text-sm text-slate-300">
          <li class="flex items-start gap-3">
            <MapPin className="w-5 h-5 text-primary shrink-0 mt-0.5" />
            <span>Jail Road, Gulberg, Lahore, Punjab, Pakistan</span>
          </li>
          <li class="flex items-center gap-3">
            <Phone className="w-4 h-4 text-primary shrink-0" />
            <a href="tel:+923368899996" class="hover:text-white transition-colors">
              +92 33 68899 996
            </a>
          </li>
          <li class="flex items-center gap-3">
            <Phone className="w-4 h-4 text-primary shrink-0" />
            <a href="tel:+923398080808" class="hover:text-white transition-colors">
              +92 339 8080808
            </a>
          </li>
          <li class="flex items-center gap-3">
            <Mail className="w-4 h-4 text-primary shrink-0" />
            <a href="mailto:support@doctormarriagebureau.com.pk" class="hover:text-white transition-colors">
              support@doctormarriagebureau.com.pk
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Quick Inquiry -->
      <div>
        <h3 class="text-base font-bold text-white mb-4 tracking-wide flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-primary"></span>
          Quick Inquiry
        </h3>
        <p class="text-slate-300 text-xs mb-3">
          Have a question about matchmaking packages? Send us a quick message.
        </p>
        <form class="space-y-2.5" id="footer-contact-form" action="/api/contact" method="POST">
          <input 
            type="text" 
            name="name" 
            placeholder="Your Full Name" 
            required
            class="w-full px-3 py-2 text-xs rounded-xl bg-white/10 border border-white/15 text-white placeholder-slate-400 focus:outline-none focus:border-primary"
          />
          <input 
            type="tel" 
            name="phone" 
            placeholder="Phone / WhatsApp Number" 
            required
            class="w-full px-3 py-2 text-xs rounded-xl bg-white/10 border border-white/15 text-white placeholder-slate-400 focus:outline-none focus:border-primary"
          />
          <textarea 
            name="message" 
            rows="2" 
            placeholder="Your Message..." 
            required
            class="w-full px-3 py-2 text-xs rounded-xl bg-white/10 border border-white/15 text-white placeholder-slate-400 focus:outline-none focus:border-primary resize-none"
          ></textarea>
          <button 
            type="submit" 
            class="w-full py-2.5 px-4 rounded-xl bg-primary hover:bg-primary-hover text-white text-xs font-bold tracking-wide transition-colors flex items-center justify-center gap-2 shadow-sm"
          >
            <span>Send Inquiry</span>
            <Send className="w-3.5 h-3.5" />
          </button>
        </form>
      </div>

    </div>

    <!-- Bottom Copyright & Disclaimer -->
    <div class="pt-8 border-t border-white/10 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-slate-400">
      <p>© {new Date().getFullYear()} Doctor Marriage Bureau. All Rights Reserved.</p>
      <p class="flex items-center gap-1">
        Dedicated to Halal Muslim Matrimony with Respect & Privacy
      </p>
    </div>
  </div>
</footer>
