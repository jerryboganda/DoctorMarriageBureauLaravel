---
import { 
  LayoutDashboard, 
  Search, 
  HeartHandshake, 
  MessageSquare, 
  GitMerge, 
  UserCircle, 
  Crown, 
  Settings, 
  LogOut, 
  ShieldCheck, 
  Sparkles,
  Users,
  Wallet,
  Share2
} from 'lucide-react';

const currentPath = Astro.url.pathname;

const navGroups = [
  {
    title: 'Matchmaking',
    items: [
      { label: 'Overview', href: '/dashboard/', icon: LayoutDashboard },
      { label: 'Find Doctors', href: '/discover/', icon: Search, badge: 'New' },
      { label: 'My Proposals', href: '/proposals/', icon: HeartHandshake, badgeSlot: 'proposals' },
      { label: 'Messages', href: '/messages/', icon: MessageSquare, badgeSlot: 'messages' },
      { label: 'Courtship Journey', href: '/progression/', icon: GitMerge },
    ]
  },
  {
    title: 'Profile & Network',
    items: [
      { label: 'My Doctor Profile', href: '/profile/', icon: UserCircle },
      { label: 'Doctor Community', href: '/community/', icon: Users },
      { label: 'Wallet & Coins', href: '/wallet/', icon: Wallet },
      { label: 'Refer & Earn', href: '/referrals/', icon: Share2 },
    ]
  },
  {
    title: 'Account',
    items: [
      { label: 'Membership Plans', href: '/packages/', icon: Crown, highlight: true },
      { label: 'Security & Settings', href: '/settings/', icon: Settings },
    ]
  }
];
---

<aside class="hidden lg:flex flex-col w-72 bg-white border-r border-brand-100/80 min-h-[calc(100vh-5rem)] p-5 justify-between sticky top-20 shadow-sm z-30">
  <div class="space-y-6">
    
    <!-- User Quick Mini-Profile Card -->
    <div class="p-4 rounded-2xl bg-gradient-to-br from-brand-50/80 via-white to-pink-50/50 border border-brand-100/80 shadow-luxury flex items-center gap-3">
      <div class="relative">
        <div class="w-12 h-12 rounded-full overflow-hidden border-2 border-brand-500 shadow-sm bg-navy-100">
          <img 
            src="/assets/img/avatar-place.png" 
            data-dmb-avatar
            alt="Doctor Profile" 
            class="w-full h-full object-cover"
          />
        </div>
        <span class="absolute -bottom-1 -right-1 p-0.5 bg-emerald-500 rounded-full text-white" title="PMDC Verified">
          <ShieldCheck className="w-3 h-3" />
        </span>
      </div>
      
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-1.5">
          <h4 data-dmb-user-name class="text-sm font-bold text-navy-800 truncate">&nbsp;</h4>
        </div>
        <p data-dmb-sidebar-degree class="text-xs text-brand-600 font-medium truncate">&nbsp;</p>
        <span data-dmb-sidebar-tier class="inline-block w-[156px] h-[21px] mt-0.5 px-2 py-0.5 rounded-full text-[10px] font-bold bg-brand-500/10 text-brand-700 border border-brand-500/20 truncate text-center">
          &nbsp;
        </span>
      </div>
    </div>

    <!-- Navigation Groups -->
    <nav class="space-y-6">
      {navGroups.map((group) => (
        <div class="space-y-1.5">
          <h5 class="px-3 text-[11px] font-bold uppercase tracking-wider text-navy-400">
            {group.title}
          </h5>
          <div class="space-y-1">
            {group.items.map((item) => {
              const Icon = item.icon;
              const isActive = currentPath === item.href || (item.href !== '/dashboard/' && currentPath.startsWith(item.href));
              return (
                <a
                  href={item.href}
                  class={`flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all duration-200 group ${
                    isActive
                      ? 'bg-gradient-to-r from-brand-500 to-brand-600 text-white shadow-md shadow-brand-500/25 font-bold'
                      : item.highlight
                      ? 'bg-gold-light/40 text-gold-dark hover:bg-gold-light/60 border border-gold/50'
                      : 'text-navy-700 hover:text-brand-600 hover:bg-brand-50/60'
                  }`}
                >
                  <div class="flex items-center gap-3">
                    <Icon className={`w-4 h-4 transition-transform group-hover:scale-110 ${
                      isActive ? 'text-white' : item.highlight ? 'text-gold-dark' : 'text-navy-500 group-hover:text-brand-600'
                    }`} />
                    <span>{item.label}</span>
                  </div>

                  {item.badge && (
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-brand-100 text-brand-700">
                      {item.badge}
                    </span>
                  )}

                  {item.badgeSlot && (
                    <span 
                      {...{ [`data-dmb-badge-${item.badgeSlot}`]: true }}
                      class={`hidden px-2 py-0.5 rounded-full text-[10px] font-bold ${
                        isActive ? 'bg-white text-brand-600' : 'bg-brand-500 text-white'
                      }`}>
                    </span>
                  )}
                </a>
              );
            })}
          </div>
        </div>
      ))}
    </nav>

  </div>

  <!-- Upgrade Premium Banner Box -->
  <div class="pt-4 border-t border-brand-100/80 space-y-3">
    <div class="p-4 rounded-2xl bg-gradient-to-br from-navy-950 via-navy-900 to-navy-950 text-white relative overflow-hidden shadow-lg">
      <div class="absolute -right-4 -bottom-4 w-20 h-20 bg-brand-500/20 rounded-full blur-xl"></div>
      <div class="relative z-10 space-y-2">
        <div class="flex items-center gap-1.5 text-brand-300 text-xs font-bold">
          <Sparkles className="w-4 h-4 text-brand-400" />
          <span>Doctor Elite VIP</span>
        </div>
        <p class="text-[11px] text-navy-200 leading-relaxed">
          Unlock direct phone contacts & personalized family matchmaker meetings.
        </p>
        <a
          href="/packages/"
          class="block w-full text-center py-2 px-3 rounded-full bg-gradient-to-r from-brand-500 via-brand-600 to-pink-600 hover:from-brand-600 hover:to-pink-700 text-white text-xs font-bold shadow-lg shadow-brand-500/30 hover:shadow-brand-500/50 transition-all transform hover:-translate-y-0.5 active:scale-[0.98]"
        >
          Upgrade Plan
        </a>
      </div>
    </div>

    <!-- Admin Console Shortcut — visible only to admins (hidden by default, verified via API) -->
    <a
      id="admin-console-link"
      href="/admin/"
      class="hidden flex items-center justify-between px-3.5 py-2 text-xs font-bold text-navy-800 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors"
    >
      <div class="flex items-center gap-2">
        <ShieldCheck className="w-4 h-4 text-brand-600" />
        <span>Admin Console</span>
      </div>
      <span class="px-1.5 py-0.5 rounded text-[9px] font-black uppercase bg-brand-500 text-white">
        PRO
      </span>
    </a>

    <!-- Sign Out Button -->
    <a
      href="/login/"
      data-dmb-logout
      class="flex items-center gap-2.5 px-3.5 py-2 text-xs font-semibold text-brand-700 hover:bg-brand-50 rounded-xl transition-colors"
    >
      <LogOut className="w-4 h-4" />
      <span>Sign Out</span>
    </a>
  </div>
</aside>

<script>
  // Show Admin Console only to verified admins - otherwise keep hidden (fixes major leak)
  (function () {
    const link = document.getElementById('admin-console-link');
    if (!link) return;
    const token = localStorage.getItem('auth_token');
    if (!token) return;
    const API = (import.meta.env.PUBLIC_API_URL || 'http://127.0.0.1:8080/api/v1').replace(/\/$/, '');
    fetch(API + '/admin/stats', { headers: { Authorization: 'Bearer ' + token } })
      .then(function (res) { if (res.ok) link.classList.remove('hidden'); })
      .catch(function () {});
  })();
</script>
