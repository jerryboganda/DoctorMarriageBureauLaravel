---
import Layout from '../layouts/Layout.astro';
import { ShieldCheck, Lock, EyeOff, FileText } from 'lucide-react';
---

<Layout 
  title="Privacy Policy & Doctor Confidentiality Safeguards | Doctor Marriage Bureau"
  description="Official Privacy Policy and confidentiality standards of Doctor Marriage Bureau Pakistan. Learn how doctor credentials, photos, and personal data are protected."
>
  
  <!-- Header Banner -->
  <section class="py-20 bg-gradient-to-b from-navy-950 via-navy-900 to-navy-950 text-white text-center relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-brand-500/20 via-transparent to-transparent"></div>
    
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-4">
      <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold text-brand-300 bg-white/10 border border-white/15 tracking-wider uppercase">
        Legal & Privacy
      </span>
      
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
        Privacy & Confidentiality Policy
      </h1>
      
      <p class="text-base sm:text-lg text-navy-100 max-w-2xl mx-auto text-white/90">
        Doctor Marriage Bureau is committed to maintaining the highest standard of personal dignity, medical confidentiality, and data protection.
      </p>
    </div>
  </section>

  <!-- Policy Content Body -->
  <section class="py-20 bg-[#FAFAFD]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="bg-white rounded-3xl p-8 sm:p-12 border border-brand-100 shadow-luxury space-y-8 text-navy-800 text-sm sm:text-base leading-relaxed">
        
        <div>
          <h2 class="text-2xl font-bold text-navy-950 mb-3 flex items-center gap-2">
            <Lock className="w-5 h-5 text-brand-500" />
            <span>1. Profile Confidentiality & Photo Privacy</span>
          </h2>
          <p class="text-navy-700 leading-relaxed">
            All candidate photographs displayed publicly on marketing platforms are automatically blurred to safeguard identity. Full facial photographs and detailed contact credentials are strictly restricted and shared only between mutually interested families after formal consent.
          </p>
        </div>

        <div class="pt-6 border-t border-navy-100">
          <h2 class="text-2xl font-bold text-navy-950 mb-3 flex items-center gap-2">
            <ShieldCheck className="w-5 h-5 text-brand-500" />
            <span>2. Verification of Medical Credentials</span>
          </h2>
          <p class="text-navy-700 leading-relaxed">
            When you register, we verify your educational credentials (MBBS, BDS, FCPS, MD, MRCP, PMDC registration number). These documents are used solely for identity verification and anti-fraud purposes and are never published publicly or shared with third parties.
          </p>
        </div>

        <div class="pt-6 border-t border-navy-100">
          <h2 class="text-2xl font-bold text-navy-950 mb-3 flex items-center gap-2">
            <EyeOff className="w-5 h-5 text-brand-500" />
            <span>3. Zero Commercial Data Selling</span>
          </h2>
          <p class="text-navy-700 leading-relaxed">
            Doctor Marriage Bureau does not sell, lease, rent, or distribute personal phone numbers, emails, or demographic information to commercial advertisers or external data brokers under any circumstances.
          </p>
        </div>

        <div class="pt-6 border-t border-navy-100">
          <h2 class="text-2xl font-bold text-navy-950 mb-3 flex items-center gap-2">
            <FileText className="w-5 h-5 text-brand-500" />
            <span>4. Account Deletion & Right to be Forgotten</span>
          </h2>
          <p class="text-navy-700 leading-relaxed">
            Once a candidate completes their Nikah or chooses to withdraw their search, their profile and documents are promptly archived or purged from our active registry upon request.
          </p>
        </div>

        <div class="pt-6 border-t border-navy-100 bg-brand-50/50 p-6 rounded-2xl border border-brand-100">
          <h3 class="text-base font-bold text-navy-950 mb-1">Questions Regarding Privacy?</h3>
          <p class="text-xs sm:text-sm text-navy-700">
            For privacy-related inquiries, contact our data protection officer at <a href="mailto:support@doctormarriagebureau.com.pk" class="text-brand-600 font-semibold underline">support@doctormarriagebureau.com.pk</a>.
          </p>
        </div>

      </div>

    </div>
  </section>

</Layout>
