---
import Layout from '../layouts/Layout.astro';
import { ShieldCheck, HelpCircle, PhoneCall } from 'lucide-react';

const faqs = [
  { q: "How does verification work for doctor profiles?", a: "Every doctor candidate is verified through their official medical degree, institutional records (such as PMDC / PMC / GMC / USMLE / FCPS registration), and direct family contact before profile approval." },
  { q: "Is photo privacy guaranteed?", a: "Yes. All public photos are blurred by default on the marketing platform. Photos are only shared privately after mutual interest and family permission." },
  { q: "Are there any hidden broker commissions after marriage?", a: "No. Doctor Marriage Bureau operates on 100% transparent membership fees. We charge zero hidden commissions or unannounced percentages." },
  { q: "Can overseas Pakistani doctors register?", a: "Absolutely. We have hundreds of Pakistani doctors practicing in the UK (NHS), USA, Canada, Australia, Saudi Arabia, and the UAE." },
];
---

<Layout
  title="Membership Packages & Pricing - Simple, Transparent Matchmaking | Doctor Marriage Bureau"
  description="Explore live doctor matrimonial packages with transparent pricing and zero hidden commissions."
>
  <section class="py-20 bg-gradient-to-b from-navy-950 via-navy-900 to-navy-950 text-white text-center relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-brand-500/20 via-transparent to-transparent"></div>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-4">
      <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold text-brand-300 bg-white/10 border border-white/15 tracking-wider uppercase">Membership Plans</span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white">Simple, Transparent Membership</h1>
      <p class="text-base sm:text-lg text-white/90 max-w-2xl mx-auto">Choose the package that suits your timeline. Live pricing from the bureau, zero hidden commissions.</p>
    </div>
  </section>

  <section class="py-20 bg-[#FAFAFD] relative -mt-10 z-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div id="pkg-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch"></div>
      <div id="pkg-checkout" class="hidden mt-10 p-6 rounded-3xl bg-white border border-brand-100 shadow-luxury space-y-4 max-w-xl mx-auto">
        <h3 class="text-base font-bold text-navy-800">Submit manual payment</h3>
        <input id="pay-txn" type="text" placeholder="Transaction ID" class="w-full px-4 py-3 rounded-2xl text-xs bg-navy-50 border border-navy-200" />
        <input id="pay-coupon" type="text" placeholder="Coupon code (optional)" class="w-full px-4 py-3 rounded-2xl text-xs bg-navy-50 border border-navy-200" />
        <select id="pay-method" class="w-full px-4 py-3 rounded-2xl text-xs bg-navy-50 border border-navy-200">
          <option value="bank">Bank Transfer</option>
          <option value="jazzcash">JazzCash</option>
          <option value="easypaisa">EasyPaisa</option>
        </select>
        <div id="pay-accounts" class="text-xs text-navy-600 space-y-1"></div>
        <button id="pay-submit" class="w-full py-3 rounded-full bg-gradient-to-r from-brand-500 via-brand-600 to-pink-600 text-white text-xs font-bold">Submit for Review</button>
      </div>
      <div class="mt-16 p-6 rounded-2xl bg-white border border-brand-100 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <ShieldCheck className="w-8 h-8 text-emerald-600 shrink-0" />
          <div>
            <h4 class="text-sm font-bold text-navy-900">100% Satisfaction & Safety Guarantee</h4>
            <p class="text-xs text-navy-600">Need guidance before selecting a plan? Speak with our head matchmaker.</p>
          </div>
        </div>
        <a href="/contact/" class="px-5 py-2.5 rounded-full text-xs font-semibold text-navy-800 bg-navy-50 hover:bg-navy-100 flex items-center gap-2">
          <PhoneCall className="w-3.5 h-3.5 text-brand-500" /><span>Call Helpline</span>
        </a>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white border-t border-brand-100/60">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <span class="inline-block px-3.5 py-1.5 rounded-full text-xs font-semibold text-brand-600 bg-brand-50 border border-brand-100 tracking-wider uppercase mb-3">Frequently Asked Questions</span>
        <h2 class="text-3xl font-extrabold text-navy-900">Everything You Need to Know</h2>
      </div>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="p-6 rounded-2xl bg-gradient-to-b from-[#FFF5F8] to-white border border-brand-100/80 shadow-sm">
            <h3 class="text-base font-bold text-navy-900 mb-2 flex items-center gap-2">
              <HelpCircle className="w-4 h-4 text-brand-500 shrink-0" /><span>{faq.q}</span>
            </h3>
            <p class="text-xs sm:text-sm text-navy-700 leading-relaxed pl-6">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  import { api, escapeHtml, formatPKR, toast, errorMessage, skeletonHtml } from '../lib/dashboard/common';

  const grid = document.getElementById('pkg-grid')!;
  grid.innerHTML = skeletonHtml(3, 'h-80');
  let selectedId = 0;
  const loggedIn = Boolean(localStorage.getItem('auth_token'));

  api.get('/payments/packages').then((res) => {
    const pkgs = ((res.data?.data ?? []) as any[]).filter((p) => p.is_active !== false);
    grid.innerHTML = pkgs.map((p) => {
      const popular = Number(p.price) >= 8000 || String(p.name).toLowerCase().includes('extended');
      const features = [
        p.proposal_limit != null ? `${p.proposal_limit} proposal credits` : null,
        p.contact_view_limit != null ? `${p.contact_view_limit} contact views` : null,
        p.photo_gallery_limit != null ? `${p.photo_gallery_limit} gallery photos` : null,
        `${p.validity_days || 0} days visibility`,
        'Verified doctor badge',
        'Confidential photo privacy',
      ].filter(Boolean);
      return `
        <div class="rounded-3xl p-8 border flex flex-col justify-between relative ${popular ? 'border-brand-500/80 shadow-2xl bg-white ring-2 ring-brand-500/20' : 'border-brand-100 bg-white shadow-luxury'}">
          ${popular ? '<div class="absolute -top-4 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-gradient-to-r from-brand-500 to-brand-600 text-white text-xs font-bold">Best Value</div>' : ''}
          <div>
            <div class="flex justify-between items-baseline mb-4">
              <h3 class="text-2xl font-bold text-navy-900">${escapeHtml(p.name)}</h3>
              <span class="text-xs font-semibold text-brand-600 bg-brand-50 px-3 py-1 rounded-full border border-brand-100">${p.validity_days || 0} days</span>
            </div>
            <div class="mb-8 p-6 rounded-2xl bg-navy-50/60 border border-navy-100/80">
              <span class="text-4xl font-extrabold text-navy-900">${formatPKR(p.price)}</span>
            </div>
            <div class="space-y-3 mb-8">${features.map((f) => `<div class="flex items-start gap-3 text-xs text-navy-700"><span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">✓</span><span>${escapeHtml(f)}</span></div>`).join('')}</div>
          </div>
          <button data-pkg="${p.id}" class="w-full py-4 px-6 rounded-full text-sm font-bold ${popular ? 'bg-gradient-to-r from-brand-500 to-brand-600 text-white shadow-lg shadow-brand-500/30' : 'bg-navy-900 text-white'}">${Number(p.price) === 0 ? 'Continue Free' : 'Choose this plan'}</button>
        </div>`;
    }).join('') || '<p class="text-sm text-navy-500">No packages available.</p>';

    grid.querySelectorAll<HTMLButtonElement>('[data-pkg]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!loggedIn) { location.href = `/register/?package=${btn.dataset.pkg}`; return; }
        selectedId = Number(btn.dataset.pkg);
        document.getElementById('pkg-checkout')!.classList.remove('hidden');
        document.getElementById('pkg-checkout')!.scrollIntoView({ behavior: 'smooth' });
      });
    });
  }).catch((err) => {
    grid.innerHTML = `<p class="text-sm text-brand-600">${escapeHtml(errorMessage(err))}</p>`;
  });

  if (loggedIn) {
    api.get('/payments/manual/accounts').then((res) => {
      const accts = res.data?.data ?? [];
      document.getElementById('pay-accounts')!.innerHTML = (Array.isArray(accts) ? accts : [accts]).map((a: any) =>
        `<p><strong>${escapeHtml(a.bank || a.method || 'Account')}</strong> · ${escapeHtml(a.account_title || '')} · ${escapeHtml(a.account_number || a.iban || '')}</p>`
      ).join('');
    }).catch(() => undefined);
  }

  document.getElementById('pay-submit')?.addEventListener('click', async () => {
    if (!selectedId) { toast('Select a package first.', 'error'); return; }
    try {
      await api.post('/payments/manual/submit', {
        method: (document.getElementById('pay-method') as HTMLSelectElement).value,
        package_id: selectedId,
        transaction_id: (document.getElementById('pay-txn') as HTMLInputElement).value,
        coupon_code: (document.getElementById('pay-coupon') as HTMLInputElement).value,
      });
      toast('Payment submitted for review.', 'success');
    } catch (err) {
      toast(errorMessage(err), 'error');
    }
  });
</script>