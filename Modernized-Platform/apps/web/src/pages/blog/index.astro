---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { getCollection } from 'astro:content';
import { BookOpen, Calendar, Eye, Search, ArrowRight } from 'lucide-react';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => {
  const dateA = new Date(a.data.date).getTime();
  const dateB = new Date(b.data.date).getTime();
  return dateB - dateA;
});

const featuredPost = sortedPosts[0];
const remainingPosts = sortedPosts.slice(1);

const categories = Array.from(new Set(allPosts.map((p) => p.data.category).filter(Boolean)));
---

<PublicLayout 
  title="Doctor Matrimonial Insights & Guides | Doctor Marriage Bureau Blog"
  description="Read expert guides, Islamic marriage advice, career balance tips for doctors, and medical matchmaking insights in Pakistan."
>

  <!-- Hero Header -->
  <section class="py-16 lg:py-24 bg-gradient-to-b from-navy-950 via-navy-900 to-navy-950 text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#FF206E_1px,transparent_1px)] [background-size:24px_24px]"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-brand-500/20 border border-brand-500/30 text-brand-300 text-xs font-semibold">
        <BookOpen className="w-4 h-4" />
        <span>Medical Matrimonial Insights</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight">
        Doctor Marriage Bureau <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-400 to-pink-400">Blog</span>
      </h1>

      <p class="max-w-2xl mx-auto text-sm sm:text-base text-navy-200">
        Articles, tips, and insights on Islamic matrimony, doctor lifestyle compatibility, and successful doctor marriages across Pakistan and abroad.
      </p>
    </div>
  </section>

  <!-- Blog Main Section -->
  <main class="py-16 bg-[#FAFAFD]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- Featured Post Banner -->
      {featuredPost && (
        <div class="rounded-3xl bg-white border border-brand-100/80 shadow-luxury overflow-hidden grid grid-cols-1 lg:grid-cols-12 gap-8 items-center p-6 lg:p-8">
          <div class="lg:col-span-7 rounded-2xl overflow-hidden aspect-video bg-navy-100">
            <img 
              src={featuredPost.data.featuredImage} 
              alt={featuredPost.data.title} 
              class="w-full h-full object-cover transform hover:scale-105 transition-transform duration-500"
              width="600"
              height="340"
            />
          </div>
          <div class="lg:col-span-5 space-y-4">
            <div class="flex items-center gap-2 text-xs font-semibold text-brand-600">
              <span class="px-3 py-1 rounded-full bg-brand-50 border border-brand-100">
                {featuredPost.data.category}
              </span>
              <span>•</span>
              <span class="text-navy-400">{featuredPost.data.date}</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-900 leading-tight">
              <a href={`/${featuredPost.data.slug}/`} class="hover:text-brand-600 transition-colors">
                {featuredPost.data.title}
              </a>
            </h2>
            <p class="text-sm text-navy-600 line-clamp-3">
              {featuredPost.data.excerpt}
            </p>
            <div class="pt-4">
              <a 
                href={`/${featuredPost.data.slug}/`} 
                class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-xs font-bold text-white bg-brand-500 hover:bg-brand-600 shadow-md transition-all"
              >
                <span>Read Full Article</span>
                <ArrowRight className="w-4 h-4" />
              </a>
            </div>
          </div>
        </div>
      )}

      <!-- All Posts Grid -->
      <div class="space-y-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-brand-100">
          <h3 class="text-2xl font-extrabold text-navy-900">All Published Articles ({allPosts.length})</h3>
          
          <!-- Category Filter Pills -->
          <div class="flex flex-wrap items-center gap-2">
            <span class="px-3 py-1 rounded-full text-xs font-bold bg-brand-600 text-white">All</span>
            {categories.map((cat) => (
              <span class="px-3 py-1 rounded-full text-xs font-medium bg-white text-navy-700 border border-navy-200">
                {cat}
              </span>
            ))}
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {remainingPosts.map((post) => (
            <article class="group rounded-2xl bg-white border border-brand-100/80 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden flex flex-col justify-between">
              <div>
                <div class="aspect-video w-full overflow-hidden bg-navy-100 relative">
                  <img 
                    src={post.data.featuredImage} 
                    alt={post.data.title} 
                    class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
                    width="400"
                    height="225"
                    loading="lazy"
                  />
                  <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full text-[11px] font-bold bg-white/95 backdrop-blur-md text-brand-600 shadow-sm">
                    {post.data.category}
                  </span>
                </div>

                <div class="p-6 space-y-3">
                  <div class="flex items-center gap-3 text-xs text-navy-400">
                    <span class="flex items-center gap-1">
                      <Calendar className="w-3.5 h-3.5" />
                      {post.data.date}
                    </span>
                    <span>•</span>
                    <span class="flex items-center gap-1">
                      <Eye className="w-3.5 h-3.5" />
                      {post.data.views} views
                    </span>
                  </div>

                  <h3 class="text-base font-bold text-navy-900 group-hover:text-brand-600 transition-colors line-clamp-2">
                    <a href={`/${post.data.slug}/`}>
                      {post.data.title}
                    </a>
                  </h3>

                  <p class="text-xs text-navy-600 line-clamp-2 leading-relaxed">
                    {post.data.excerpt}
                  </p>
                </div>
              </div>

              <div class="p-6 pt-0">
                <a 
                  href={`/${post.data.slug}/`} 
                  class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-600 group-hover:text-brand-700 transition-colors"
                >
                  <span>Read Article</span>
                  <ArrowRight className="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" />
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>

    </div>
  </main>

</PublicLayout>
