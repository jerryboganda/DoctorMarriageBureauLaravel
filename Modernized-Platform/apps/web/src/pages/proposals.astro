---
import DashboardLayout from '../layouts/DashboardLayout.astro';
---

<DashboardLayout
  title="My Proposals — Doctor Marriage Bureau"
  description="Manage received and sent doctor marriage proposals."
>
  <div class="space-y-8 animate-fadeIn max-w-4xl">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-black text-navy-800 font-serif">
          Proposal <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-500 via-brand-600 to-pink-600">Center</span>
        </h1>
        <p class="text-xs sm:text-sm text-navy-500">Review inquiries, accept matches, and unlock private conversations</p>
      </div>
      <div class="inline-flex items-center gap-2 p-1 bg-navy-100 rounded-full">
        <button data-tab="received" class="px-4 py-2 rounded-full text-xs font-bold bg-white text-brand-600 shadow-sm">Received</button>
        <button data-tab="sent" class="px-4 py-2 rounded-full text-xs font-semibold text-navy-600 hover:text-navy-800">Sent</button>
        <button data-tab="accepted" class="px-4 py-2 rounded-full text-xs font-semibold text-navy-600 hover:text-navy-800">Mutual</button>
      </div>
    </div>
    <div id="proposals-list" class="space-y-4"></div>
  </div>
</DashboardLayout>

<script>
  import {
    api,
    avatarFor,
    escapeHtml,
    timeAgo,
    toast,
    errorMessage,
    emptyStateHtml,
    errorStateHtml,
    skeletonHtml,
    doctorName,
  } from '../lib/dashboard/common';

  const list = document.getElementById('proposals-list')!;
  let tab: 'received' | 'sent' | 'accepted' = 'received';

  function setTabs() {
    document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((btn) => {
      const active = btn.dataset.tab === tab;
      btn.className = active
        ? 'px-4 py-2 rounded-full text-xs font-bold bg-white text-brand-600 shadow-sm'
        : 'px-4 py-2 rounded-full text-xs font-semibold text-navy-600 hover:text-navy-800';
    });
  }

  async function load() {
    setTabs();
    list.innerHTML = skeletonHtml(3, 'h-28');
    try {
      const type = tab === 'sent' ? 'sent' : 'received';
      const res = await api.get('/interests/requests', { params: { type } });
      let items = (res.data?.data ?? []) as any[];
      if (tab === 'received') items = items.filter((i) => String(i.status) === 'pending');
      if (tab === 'accepted') items = items.filter((i) => String(i.status) === 'accepted');
      if (!items.length) {
        list.innerHTML = emptyStateHtml(
          tab === 'sent' ? 'No sent proposals yet' : tab === 'accepted' ? 'No mutual matches yet' : 'No pending proposals',
          'When a verified doctor connects with you, it will appear here.',
        );
        return;
      }
      list.innerHTML = items
        .map((p) => {
          const other = p.candidate || {};
          const name = escapeHtml(p.sender_name || p.recipient_name || doctorName(other));
          const degree = escapeHtml(other.degree || other.speciality || 'Verified Medical Professional');
          const city = escapeHtml([other.city_name, other.country_name].filter(Boolean).join(', '));
          const photo = avatarFor(other.profile_photo_url, other.gender);
          const status = String(p.status || 'pending');
          const actions =
            tab === 'received' && status === 'pending'
              ? `<button data-accept="${p.id}" class="py-2.5 px-4 rounded-full bg-gradient-to-r from-brand-500 via-brand-600 to-pink-600 text-white text-xs font-bold shadow-lg shadow-brand-500/30">Accept Proposal</button>
                 <button data-reject="${p.id}" class="py-2.5 px-3 rounded-xl bg-navy-100 text-navy-700 text-xs font-semibold">Decline</button>`
              : tab === 'sent' && status === 'pending'
                ? `<button data-withdraw="${p.id}" class="py-2.5 px-3 rounded-xl bg-navy-100 text-navy-700 text-xs font-semibold">Withdraw</button>`
                : status === 'accepted' && p.chat_thread_id
                  ? `<a href="/messages/?thread=${p.chat_thread_id}" class="py-2.5 px-5 rounded-xl bg-emerald-600 text-white text-xs font-bold">Open Chat</a>`
                  : `<span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-navy-100 text-navy-600">${escapeHtml(status)}</span>`;
          return `
            <div class="p-6 rounded-3xl bg-white border border-brand-100/80 shadow-luxury flex flex-col md:flex-row md:items-center justify-between gap-6">
              <div class="flex items-start gap-4">
                <div class="w-16 h-16 rounded-2xl overflow-hidden bg-navy-100 border border-brand-200 shrink-0">
                  <img src="${photo}" alt="${name}" class="w-full h-full object-cover" />
                </div>
                <div class="space-y-1">
                  <div class="flex items-center gap-2">
                    <h3 class="text-base font-bold text-navy-800">${name}</h3>
                    ${other.is_verified ? '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-700">Verified</span>' : ''}
                  </div>
                  <p class="text-xs font-semibold text-brand-600">${degree}</p>
                  <p class="text-xs text-navy-500">${city || timeAgo(p.created_at)}${p.message ? ` · “${escapeHtml(p.message)}”` : ''}</p>
                </div>
              </div>
              <div class="flex items-center gap-2.5 shrink-0">${actions}
                <a href="/discover/?view=${other.user_id || p.sender_user_id || p.recipient_user_id || ''}" class="py-2.5 px-3.5 rounded-xl bg-navy-50 border border-navy-200 text-navy-700 text-xs font-bold">Full Biodata</a>
              </div>
            </div>`;
        })
        .join('');

      list.querySelectorAll<HTMLButtonElement>('[data-accept]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          btn.disabled = true;
          try {
            const res = await api.post(`/interests/${btn.dataset.accept}/accept`);
            toast('Proposal accepted! Opening chat…', 'success');
            const tid = res.data?.data?.chat_thread_id;
            setTimeout(() => { window.location.href = tid ? `/messages/?thread=${tid}` : '/messages/'; }, 700);
          } catch (err) {
            btn.disabled = false;
            toast(errorMessage(err), 'error');
          }
        });
      });
      list.querySelectorAll<HTMLButtonElement>('[data-reject]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          btn.disabled = true;
          try {
            await api.post(`/interests/${btn.dataset.reject}/reject`);
            toast('Proposal declined.', 'info');
            load();
          } catch (err) {
            btn.disabled = false;
            toast(errorMessage(err), 'error');
          }
        });
      });
      list.querySelectorAll<HTMLButtonElement>('[data-withdraw]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          btn.disabled = true;
          try {
            await api.post(`/interests/${btn.dataset.withdraw}/withdraw`);
            toast('Proposal withdrawn.', 'info');
            load();
          } catch (err) {
            btn.disabled = false;
            toast(errorMessage(err), 'error');
          }
        });
      });
    } catch (err) {
      list.innerHTML = errorStateHtml(errorMessage(err));
      list.querySelector('[data-dmb-retry]')?.addEventListener('click', load);
    }
  }

  document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((btn) => {
    btn.addEventListener('click', () => {
      tab = btn.dataset.tab as typeof tab;
      load();
    });
  });
  load();
</script>