---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/forms/ContactForm';
import { Phone, Mail, MapPin, Clock } from 'lucide-react';
---

<Layout 
  title="Contact Us - Matrimonial Consultation & Helpline | Doctor Marriage Bureau"
  description="Contact Doctor Marriage Bureau Pakistan. Phone: +92 33 68899 996, Email: support@doctormarriagebureau.com.pk. Office: Jail Road, Gulberg, Lahore."
>
  
  <!-- Header Banner -->
  <section class="py-20 bg-gradient-to-b from-navy-950 via-navy-900 to-navy-950 text-white text-center relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-brand-500/20 via-transparent to-transparent"></div>
    
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-4">
      <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold text-brand-300 bg-white/10 border border-white/15 tracking-wider uppercase">
        Get In Touch
      </span>
      
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
        Contact Our Matchmaking Team
      </h1>
      
      <p class="text-base sm:text-lg text-navy-100 max-w-2xl mx-auto text-white/90">
        Our experienced matrimonial consultants are available to assist you and your family with personal consultations and package assistance.
      </p>
    </div>
  </section>

  <!-- Contact Body -->
  <section class="py-20 bg-[#FAFAFD]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 items-start mb-16">
        
        <!-- Left: Contact Details Cards (1 Col) -->
        <div class="space-y-6">
          
          <!-- Card 1: Phone -->
          <div class="p-6 rounded-3xl bg-white border border-brand-100/80 shadow-sm flex items-start gap-4">
            <div class="w-12 h-12 rounded-2xl bg-brand-50 text-brand-600 flex items-center justify-center shrink-0">
              <Phone className="w-6 h-6" />
            </div>
            <div>
              <h3 class="text-sm font-bold text-navy-900">Direct Phone / WhatsApp</h3>
              <p class="text-xs text-navy-500 mt-1 mb-2">Speak directly with senior matchmakers</p>
              <a href="tel:+923368899996" class="text-sm font-semibold text-brand-600 hover:text-brand-700 block">
                +92 33 68899 996
              </a>
              <a href="tel:+923398080808" class="text-sm font-semibold text-navy-700 hover:text-navy-900 block mt-0.5">
                +92 339 8080808
              </a>
            </div>
          </div>

          <!-- Card 2: Email -->
          <div class="p-6 rounded-3xl bg-white border border-brand-100/80 shadow-sm flex items-start gap-4">
            <div class="w-12 h-12 rounded-2xl bg-navy-50 text-navy-800 flex items-center justify-center shrink-0">
              <Mail className="w-6 h-6" />
            </div>
            <div>
              <h3 class="text-sm font-bold text-navy-900">Email Support</h3>
              <p class="text-xs text-navy-500 mt-1 mb-2">Official inquiries & credential submission</p>
              <a href="mailto:support@doctormarriagebureau.com.pk" class="text-sm font-semibold text-brand-600 hover:text-brand-700 break-all">
                support@doctormarriagebureau.com.pk
              </a>
            </div>
          </div>

          <!-- Card 3: Address & Hours -->
          <div class="p-6 rounded-3xl bg-white border border-brand-100/80 shadow-sm flex items-start gap-4">
            <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
              <MapPin className="w-6 h-6" />
            </div>
            <div>
              <h3 class="text-sm font-bold text-navy-900">Bureau Location</h3>
              <p class="text-xs text-navy-700 mt-1">
                Jail Road, Gulberg, Lahore, Punjab, Pakistan
              </p>
              <div class="mt-3 flex items-center gap-1.5 text-xs text-navy-500 font-medium">
                <Clock className="w-3.5 h-3.5 text-navy-400" />
                <span>Mon – Sat: 10:00 AM – 7:00 PM</span>
              </div>
            </div>
          </div>

        </div>

        <!-- Right: Interactive Contact Form (2 Cols) -->
        <div class="lg:col-span-2">
          <ContactForm client:visible />
        </div>

      </div>

      <!-- Google Maps Embed Section -->
      <div class="rounded-3xl overflow-hidden shadow-luxury border border-brand-100 bg-white">
        <div class="p-6 border-b border-navy-50 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <MapPin className="w-5 h-5 text-brand-500" />
            <h3 class="text-base font-bold text-navy-900">Office Location Map — Lahore, Pakistan</h3>
          </div>
          <span class="text-xs text-navy-500 hidden sm:inline">Jail Road, Gulberg, Lahore</span>
        </div>
        
        <iframe 
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d108848.47355088414!2d74.28189679999999!3d31.5203696!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3919045a55555555%3A0x123456789!2sJail%20Rd%2C%20Gulberg%2C%20Lahore!5e0!3m2!1sen!2spk!4v1700000000000!5m2!1sen!2spk" 
          width="100%" 
          height="380" 
          style="border:0;" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade"
          class="w-full h-80 sm:h-96"
          title="Doctor Marriage Bureau Lahore Location"
        ></iframe>
      </div>

    </div>
  </section>

</Layout>
