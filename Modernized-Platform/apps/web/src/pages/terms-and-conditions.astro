---
import PublicLayout from '../layouts/PublicLayout.astro';
import { ShieldCheck, FileText, CheckCircle2 } from 'lucide-react';
---

<PublicLayout 
  title="Terms & Conditions — Doctor Marriage Bureau"
  description="Official terms, codes of conduct, and membership guidelines for Doctor Marriage Bureau."
>
  <section class="py-20 bg-gradient-to-b from-slate-900 via-slate-900 to-slate-950 text-white text-center relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-4">
      <span class="inline-block px-4 py-1.5 rounded-full text-xs font-bold text-pink-300 bg-white/10 border border-white/15 tracking-wider uppercase">
        Terms of Service
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
        Terms & Conditions of Membership
      </h1>
      <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto">
        Guidelines to ensure an honorable, respectful, and safe matrimonial experience for all doctors and families.
      </p>
    </div>
  </section>

  <section class="py-20 bg-slate-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm space-y-8 text-slate-800 text-sm sm:text-base leading-relaxed">
        <div>
          <h2 class="text-xl font-bold text-slate-900 mb-2">1. Authenticity of Credentials</h2>
          <p class="text-slate-600 leading-relaxed">
            All registered members confirm that the educational qualifications, PMDC registrations, and personal details provided are 100% accurate and authentic.
          </p>
        </div>

        <div class="pt-6 border-t border-slate-100">
          <h2 class="text-xl font-bold text-slate-900 mb-2">2. Respectful & Halal Conduct</h2>
          <p class="text-slate-600 leading-relaxed">
            Members agree to communicate with dignity, respect, and within Islamic boundaries. Any harassment, inappropriate language, or misrepresentation will result in immediate termination.
          </p>
        </div>

        <div class="pt-6 border-t border-slate-100">
          <h2 class="text-xl font-bold text-slate-900 mb-2">3. Fixed Membership Policy</h2>
          <p class="text-slate-600 leading-relaxed">
            Membership fees are non-refundable once profile verification is completed. Doctor Marriage Bureau does not charge any hidden percentages upon marriage.
          </p>
        </div>
      </div>
    </div>
  </section>
</PublicLayout>
